//@version=6
indicator("POC Multi-Timeframe (1D-1M)", shorttitle = "POC", overlay = true, max_lines_count = 500)

// ============================================================================
// Replica do conceito "POC / Naked POC / Tapped POC" (Point of Control multi-
// timeframe), com fonte de volume real configurável por exchange/broker.
// Ver POC-INDICATOR.md no repositório para detalhes e simplificações assumidas.
// ============================================================================

grpData   = "Data source"
grpNew    = "Timeframes - New"
grpNaked  = "Timeframes - Naked"
grpTapped = "Timeframes - Tapped"
grpLevels = "Levels"
grpCalc   = "Calculation"

realVolumeOnly = input.bool(true, "Real volume only", group = grpData,
     tooltip = "Se o símbolo resolvido só tiver volume sintético (tick volume), o indicador para com um erro em vez de desenhar níveis aproximados.")

cryptoOpt = input.string("(chart's exchange:quote)", "Crypto / Exchange:Quote", group = grpData,
     options = ["(chart's exchange:quote)", "BINANCE:USDT", "BINANCE:USDT.P", "BINANCE:USD",
     "BYBIT:USDT", "BYBIT:USDT.P", "BYBIT:USD", "COINBASE:USD", "COINBASE:USDT",
     "BITFINEX:USD", "BITSTAMP:USD", "OKX:USDT", "OKX:USDT.P", "KRAKEN:USD",
     "GATEIO:USDT", "MEXC:USDT", "Custom"],
     tooltip = "Aplica-se só quando o símbolo do gráfico é cripto. Substitui exchange E moeda de cotação, mantém a base. Ex.: em BYBIT:BTCUSDT.P, escolher COINBASE:USD dá COINBASE:BTCUSD.")
cryptoCustom = input.string("", "Crypto / Custom ticker (ex.: BYBIT:BTCUSDT.P)", group = grpData)

forexOpt = input.string("(chart's broker)", "Forex / Broker", group = grpData,
     options = ["(chart's broker)", "OANDA", "PEPPERSTONE", "EIGHTCAP", "FXCM"],
     tooltip = "Aplica-se só quando o símbolo do gráfico é forex. Substitui só o prefixo da exchange, mantém o ticker completo.")

goldOpt = input.string("(chart's broker)", "Gold / Broker", group = grpData,
     options = ["(chart's broker)", "OANDA", "PEPPERSTONE", "EIGHTCAP", "FXCM"],
     tooltip = "Aplica-se só em ouro (XAUUSD/GOLD).")

startTime = input.time(timestamp("2023-09-01T01:00:00"), "Start date", group = grpData,
     tooltip = "Os níveis só são calculados a partir desta data. Adianta a data se o indicador ficar lento.")
rowSize = input.int(24, "Row size", minval = 2, maxval = 200, group = grpData,
     tooltip = "Número de linhas em que o volume profile de cada período é dividido. Mais linhas = níveis mais finos.")

newColor   = input.color(color.new(color.gray, 0), "New - color", group = grpNew, inline = "new0")
newShow1D  = input.bool(true, "1D", group = grpNew, inline = "new1")
newShow2D  = input.bool(true, "2D", group = grpNew, inline = "new1")
newShow3D  = input.bool(true, "3D", group = grpNew, inline = "new1")
newShow5D  = input.bool(true, "5D", group = grpNew, inline = "new1")
newShow1W  = input.bool(true, "1W", group = grpNew, inline = "new2")
newShow2W  = input.bool(true, "2W", group = grpNew, inline = "new2")
newShow1M  = input.bool(true, "1M", group = grpNew, inline = "new2")

nakedColor  = input.color(color.new(#7f6fa2, 0), "Naked - color", group = grpNaked, inline = "nk0")
nakedShow1D = input.bool(true, "1D", group = grpNaked, inline = "nk1")
nakedShow2D = input.bool(true, "2D", group = grpNaked, inline = "nk1")
nakedShow3D = input.bool(true, "3D", group = grpNaked, inline = "nk1")
nakedShow5D = input.bool(true, "5D", group = grpNaked, inline = "nk1")
nakedShow1W = input.bool(true, "1W", group = grpNaked, inline = "nk2")
nakedShow2W = input.bool(true, "2W", group = grpNaked, inline = "nk2")
nakedShow1M = input.bool(true, "1M", group = grpNaked, inline = "nk2")
nakedUpdateTick = input.bool(false, "Update on every tick", group = grpNaked,
     tooltip = "OFF (default): o nível naked mais próximo do preço é escolhido uma vez por dia, ao fecho. ON: recalcula em cada tick.")

tappedColor  = input.color(color.new(#9c87be, 0), "Tapped - color", group = grpTapped, inline = "tp0")
tappedShow2D = input.bool(true, "2D", group = grpTapped, inline = "tp1")
tappedShow3D = input.bool(true, "3D", group = grpTapped, inline = "tp1")
tappedShow5D = input.bool(true, "5D", group = grpTapped, inline = "tp1")
tappedShow1W = input.bool(true, "1W", group = grpTapped, inline = "tp2")
tappedShow2W = input.bool(true, "2W", group = grpTapped, inline = "tp2")
tappedShow1M = input.bool(true, "1M", group = grpTapped, inline = "tp2")
tappedUpdateTick = input.bool(false, "Update on every tick", group = grpTapped)
countTapsBy = input.string("Whole candle", "Count taps by", options = ["Whole candle", "Candle close through"], group = grpTapped)
tapsToRemove = input.int(2, "Taps to remove", minval = 1, maxval = 20, group = grpTapped)

lineThickness = input.int(1, "Line thickness", minval = 0, maxval = 4, group = grpLevels,
     tooltip = "0 esconde as linhas no gráfico, mas mantém as etiquetas na price scale (útil se só quiseres essas).")

calcTF = input.timeframe("1D", "Timeframe", group = grpCalc,
     tooltip = "Resolução dos 'blocos' usados para construir o volume profile de cada período (1D, 2D, ... 1M são múltiplos desta timeframe).")
waitForClose = input.bool(false, "Wait for timeframe closes", group = grpCalc,
     tooltip = "OFF: taps e seleção de níveis reagem a cada tick em tempo real. ON: só reagem quando o bloco de cálculo fecha (mais estável, menos reativo).")
showDebugTable = input.bool(false, "Debug table", group = grpCalc,
     tooltip = "Mostra uma tabela no canto superior direito com estatísticas internas (histórico processado, coleções naked/tapped, etc.), usada para diagnóstico. Desligada por omissão.")

// ---------------------------------------------------------------------------
// Resolução do símbolo (exchange/broker override) + validação de volume real
// ---------------------------------------------------------------------------
isCrypto = syminfo.type == "crypto"
isForex  = syminfo.type == "forex"
baseCur  = syminfo.basecurrency
isGold   = str.contains(syminfo.ticker, "XAU") or str.contains(str.upper(syminfo.description), "GOLD")

resolveCrypto() =>
    string t = syminfo.tickerid
    if isCrypto
        if cryptoOpt == "Custom" and str.length(cryptoCustom) > 0
            t := cryptoCustom
        else if cryptoOpt != "(chart's exchange:quote)"
            parts = str.split(cryptoOpt, ":")
            if array.size(parts) == 2
                t := array.get(parts, 0) + ":" + baseCur + array.get(parts, 1)
    t

resolveForex() =>
    string t = syminfo.tickerid
    if isForex and not isGold
        prefix = forexOpt == "FXCM" ? "FX" : forexOpt
        t := prefix + ":" + syminfo.ticker
    else
        runtime.error("Forex / Broker override está definido, mas " + syminfo.ticker + " não é um símbolo forex.")
    t

resolveGold() =>
    string t = syminfo.tickerid
    if isGold
        prefix = goldOpt == "FXCM" ? "FX" : goldOpt
        t := prefix + ":" + syminfo.ticker
    else
        runtime.error("Gold / Broker override está definido, mas " + syminfo.ticker + " não é um símbolo de ouro.")
    t

var string targetSymbol = syminfo.tickerid
targetSymbol := isCrypto ? resolveCrypto() : syminfo.tickerid
if forexOpt != "(chart's broker)"
    targetSymbol := resolveForex()
if goldOpt != "(chart's broker)"
    targetSymbol := resolveGold()

cVolType = request.security(targetSymbol, calcTF, syminfo.volumetype)

if cVolType == "N/A"
    runtime.error("Símbolo " + targetSymbol + " não tem dados de volume.")
if realVolumeOnly and cVolType == "tick"
    runtime.error("Símbolo " + targetSymbol + " só fornece volume sintético (tick volume), não volume real. Desliga 'Real volume only' ou muda a exchange/broker.")

// ---------------------------------------------------------------------------
// Fonte do volume profile: velas de 1 HORA (Fixed Range Volume Profile a
// partir da vela de 1h) - confirmado como o método usado pelo indicador
// original. request.security_lower_tf exige que a timeframe pedida seja
// estritamente mais baixa que a do gráfico, por isso só é chamado quando
// useIntrabar é verdadeiro; em gráficos já a 1h ou mais grossos, usa-se a
// própria barra do gráfico (chH/chL/chV, do símbolo resolvido) como a
// "vela horária" desse ponto.
// ---------------------------------------------------------------------------
// useLowerTF: o gráfico é mais "grosso" que a Calculation Timeframe (ex.
// gráfico Semanal com calc 1D) - um request.security normal só devolveria
// o ÚLTIMO dia de cada bloco do gráfico (perdia os outros 6/7 dias por
// semana). Nesse caso usam-se sempre as velas de 1h via
// request.security_lower_tf (válido: 1h continua mais baixa que Semanal),
// agrupadas em dias manualmente pelos seus próprios timestamps - ver
// "Caminho B" mais abaixo.
useLowerTF  = timeframe.in_seconds(calcTF) < timeframe.in_seconds(timeframe.period)
useIntrabar = timeframe.in_seconds("60") < timeframe.in_seconds(timeframe.period)

[chH, chL, chV, chC] = request.security(targetSymbol, timeframe.period,
     [high, low, volume, close], lookahead = barmerge.lookahead_off)

ibH = array.new<float>()
ibL = array.new<float>()
ibV = array.new<float>()
ibT = array.new<int>()
ibC = array.new<float>()
if useIntrabar
    ibH := request.security_lower_tf(targetSymbol, "60", high)
    ibL := request.security_lower_tf(targetSymbol, "60", low)
    ibV := request.security_lower_tf(targetSymbol, "60", volume)
    ibT := request.security_lower_tf(targetSymbol, "60", time)
    ibC := request.security_lower_tf(targetSymbol, "60", close)

// ---------------------------------------------------------------------------
// Estado por timeframe
// ---------------------------------------------------------------------------
type TFState
    string tfName
    bool showNew
    bool showNaked
    bool showTapped
    int maxVisible
    bool hasTapped
    float newPrice = na
    bool hasNew = false
    array<float> nakedPrices
    array<float> tappedPrices
    array<int> tappedTaps
    line lineNew = na
    array<line> nakedLines
    line lineTapped = na

// POC de um período [fromIdx..toIdx] das arrays de amostras (h,l,v), via
// distribuição proporcional do volume de cada amostra pelas linhas do row
// size conforme a sobreposição de preço.
computePOC(array<float> hArr, array<float> lArr, array<float> vArr, int fromIdx, int toIdx, int rows) =>
    float pHi = na
    float pLo = na
    for i = fromIdx to toIdx
        hi = array.get(hArr, i)
        lo = array.get(lArr, i)
        pHi := na(pHi) ? hi : math.max(pHi, hi)
        pLo := na(pLo) ? lo : math.min(pLo, lo)
    if pHi > pLo
        bins = array.new<float>(rows, 0.0)
        binH = (pHi - pLo) / rows
        for i = fromIdx to toIdx
            hi  = array.get(hArr, i)
            lo  = array.get(lArr, i)
            vol = array.get(vArr, i)
            rng = hi - lo
            if rng <= 0
                idx = int(math.min(rows - 1, math.max(0, math.floor((lo - pLo) / binH))))
                array.set(bins, idx, array.get(bins, idx) + vol)
            else
                for j = 0 to rows - 1
                    binLo = pLo + j * binH
                    binHi = binLo + binH
                    overlap = math.min(hi, binHi) - math.max(lo, binLo)
                    if overlap > 0
                        array.set(bins, j, array.get(bins, j) + vol * (overlap / rng))
        bestIdx = 0
        bestVol = array.get(bins, 0)
        for j = 1 to rows - 1
            v = array.get(bins, j)
            if v > bestVol
                bestVol := v
                bestIdx := j
        [pLo + (bestIdx + 0.5) * binH, true]
    else
        [float(na), false]

// Paridade ABSOLUTA da semana que contém o timestamp t (0 ou 1), medida em
// semanas desde uma Segunda-feira fixa de referência (05/01/1970) - NÃO a
// partir de quando o histórico deste gráfico começa. Usado para decidir
// que semana é a "segunda" de cada par no 2W: usar array.size(weekBoundary)
// % 2 (contagem relativa a este gráfico) fazia a MESMA semana real ficar
// emparelhada com semanas diferentes consoante o gráfico tivesse mais ou
// menos histórico nativo carregado (30min vs 4H, por exemplo) - a mesma
// semana calha "par" num gráfico e "ímpar" noutro, dando um 2W diferente
// consoante o timeframe. Isto corrige isso.
weekParity(int t) =>
    int(math.floor((t - 345600000) / 604800000.0)) % 2

onPeriodClose(TFState st, float poc) =>
    if st.hasNew
        array.push(st.nakedPrices, st.newPrice)
    st.newPrice := poc
    st.hasNew := true

checkTouch(float p, float hi, float lo, float cl, float prevCl) =>
    countTapsBy == "Whole candle" ? (hi >= p and lo <= p) :
         (not na(prevCl) and ((cl >= p and prevCl < p) or (cl <= p and prevCl > p)))

processNakedTaps(TFState st, float hi, float lo, float cl, float prevCl) =>
    i = array.size(st.nakedPrices) - 1
    while i >= 0
        p = array.get(st.nakedPrices, i)
        if checkTouch(p, hi, lo, cl, prevCl)
            array.remove(st.nakedPrices, i)
            if st.hasTapped
                array.push(st.tappedPrices, p)
                array.push(st.tappedTaps, 0)
        i -= 1

processTappedTaps(TFState st, float hi, float lo, float cl, float prevCl) =>
    if st.hasTapped
        i = array.size(st.tappedPrices) - 1
        while i >= 0
            p = array.get(st.tappedPrices, i)
            if checkTouch(p, hi, lo, cl, prevCl)
                cnt = array.get(st.tappedTaps, i) + 1
                if cnt >= tapsToRemove
                    array.remove(st.tappedPrices, i)
                    array.remove(st.tappedTaps, i)
                else
                    array.set(st.tappedTaps, i, cnt)
            i -= 1

// Devolve até maxN preços de 'prices', os mais próximos de refPrice.
selectClosest(array<float> prices, int maxN, float refPrice) =>
    size = array.size(prices)
    sel = array.new<float>()
    if size > 0 and maxN > 0
        idxArr = array.new<int>()
        i = 0
        while i < size
            array.push(idxArr, i)
            i += 1
        lim = math.min(maxN, size)
        k = 0
        while k < lim
            bestJ = k
            bestD = math.abs(array.get(prices, array.get(idxArr, k)) - refPrice)
            j = k + 1
            while j < size
                d = math.abs(array.get(prices, array.get(idxArr, j)) - refPrice)
                if d < bestD
                    bestD := d
                    bestJ := j
                j += 1
            if bestJ != k
                tmp = array.get(idxArr, k)
                array.set(idxArr, k, array.get(idxArr, bestJ))
                array.set(idxArr, bestJ, tmp)
            array.push(sel, array.get(prices, array.get(idxArr, k)))
            k += 1
    sel

// Recalcula quais os níveis naked mais próximos de refPrice e guarda-os em
// dest (array persistente, tamanho fixo = maxVisible). Chamado só quando a
// cadência (tick a tick ou uma vez por bloco de cálculo) manda atualizar -
// caso contrário a seleção fica parada, daí ser um array `var` mutado aqui
// em vez de recalculada em cada barra.
updateNakedSel(TFState st, array<float> dest, float refPrice) =>
    sel = st.showNaked ? selectClosest(st.nakedPrices, st.maxVisible, refPrice) : array.new<float>()
    n = array.size(dest)
    i = 0
    while i < n
        array.set(dest, i, i < array.size(sel) ? array.get(sel, i) : float(na))
        i += 1

updateTappedSel(TFState st, float refPrice) =>
    sel = st.showTapped and st.hasTapped ? selectClosest(st.tappedPrices, 1, refPrice) : array.new<float>()
    array.size(sel) > 0 ? array.get(sel, 0) : float(na)

newTF(string name, bool showNew, bool showNaked, bool showTapped, int maxVisible, bool hasTapped) =>
    TFState.new(tfName = name, showNew = showNew, showNaked = showNaked, showTapped = showTapped,
         maxVisible = maxVisible, hasTapped = hasTapped,
         nakedPrices = array.new<float>(), tappedPrices = array.new<float>(), tappedTaps = array.new<int>(),
         nakedLines = array.new<line>())

var TFState st1D = newTF("1D", newShow1D, nakedShow1D, false,        3, false)
var TFState st2D = newTF("2D", newShow2D, nakedShow2D, tappedShow2D, 3, true)
var TFState st3D = newTF("3D", newShow3D, nakedShow3D, tappedShow3D, 3, true)
var TFState st5D = newTF("5D", newShow5D, nakedShow5D, tappedShow5D, 3, true)
var TFState st1W = newTF("1W", newShow1W, nakedShow1W, tappedShow1W, 2, true)
var TFState st2W = newTF("2W", newShow2W, nakedShow2W, tappedShow2W, 2, true)
var TFState st1M = newTF("1M", newShow1M, nakedShow1M, tappedShow1M, 2, true)
var array<TFState> allTF = array.from(st1D, st2D, st3D, st5D, st1W, st2W, st1M)

// Seleção persistente dos níveis "mais próximos do preço" atualmente
// mostrados (naked: até maxVisible; tapped: 1), separada do cálculo em si
// (que fica sempre em st.nakedPrices/tappedPrices). Só é atualizada quando
// a cadência de "Update on every tick" o permite - ver secção de Taps.
var array<float> sel1D = array.new<float>(3, na)
var array<float> sel2D = array.new<float>(3, na)
var array<float> sel3D = array.new<float>(3, na)
var array<float> sel5D = array.new<float>(3, na)
var array<float> sel1W = array.new<float>(2, na)
var array<float> sel2W = array.new<float>(2, na)
var array<float> sel1M = array.new<float>(2, na)

var float selTp2D = na
var float selTp3D = na
var float selTp5D = na
var float selTp1W = na
var float selTp2W = na
var float selTp1M = na

// ---------------------------------------------------------------------------
// Blocos de cálculo (calcTF) e deteção de fecho de período
// ---------------------------------------------------------------------------
// barH/barL/barV: amostras HORÁRIAS de todo o histórico, num único array
// "achatado" (não 1 valor por dia - ~24 valores por dia). dayStart[i] é o
// índice em barH onde as amostras do dia i começam; dayCloseT[i] é o
// timestamp de fecho desse dia (para agrupar por mês). monthBoundary
// guarda índices de DIA (não de amostra horária) onde um novo mês começa.
var array<float> barH = array.new<float>()
var array<float> barL = array.new<float>()
var array<float> barV = array.new<float>()
var array<int>   dayStart  = array.new<int>()
var array<int>   dayCloseT = array.new<int>()
var array<int>   monthBoundary = array.new<int>()
// weekBoundary guarda índices de DIA onde uma nova semana de calendário
// (Segunda-feira) começa - usado para 1W/2W alinhados a semanas reais, e
// para o reset semanal de 2D/3D/5D (ver dowIdx mais abaixo): o(s) dia(s)
// que sobra(m) no fim da semana não se juntam à seguinte, a contagem
// recomeça do zero em cada Segunda. Isto substitui janelas rolantes
// (7/14 dias seguidos, independente do dia da semana), que não batiam
// certo com o texto público do original ("1W - Mon-Sun") nem com a
// tooltip do Start date, que confirma não ser uma âncora de período.
var array<int>   weekBoundary = array.new<int>()
var float lastDailyClose = na

// Acumulação horária do dia em curso: todayH/L/V juntam, ao longo do dia,
// as velas de 1h (ibH/ibL/ibV, Caminho A/B) - ou, se não houver dados
// horários disponíveis para essa barra (histórico fora do alcance do
// request.security_lower_tf), a própria barra do gráfico (chH/chL/chV)
// como amostra de reserva, para nenhuma barra do dia ficar sem contribuir
// nada.
var array<float> todayH = array.new<float>()
var array<float> todayL = array.new<float>()
var array<float> todayV = array.new<float>()
var int ibConsumed = 0
var int ibLastBarIdx = -1

// Em gráficos a 1H ou mais finos, request.security_lower_tf(...,"60",...)
// não é válido (1h deixa de ser mais baixa que o gráfico) - por isso essas
// barras têm de ser agrupadas em blocos de 1 HORA REAL antes de entrarem
// em todayH/L/V, para dar a mesma granularidade que os gráficos mais
// grossos conseguem via request.security_lower_tf. Sem isto, um gráfico
// de 30min usava as suas 48 meias-horas/dia diretamente (mais fino que 1h)
// enquanto um gráfico de 4H usava 24 horas reais/dia - granularidades
// diferentes, POCs diferentes para o mesmo dia real.
var float hourH = na
var float hourL = na
var float hourV = 0.0

// dHi/dLo/dT/dC guardam o alto/baixo/timestamp/close do dia que acabou de
// fechar mais recentemente - preenchidos por closeDay() (Caminho A ou B),
// lidos pelos blocos "if hadNewDay" mais à frente (taps e seleção). Têm de
// ser `var` (persistentes) e atribuídos com ":=" pelo chamador de
// closeDay(), não dentro da função - o Pine não deixa reatribuir uma
// variável global escalar de dentro de uma função (só mutar arrays/campos
// de objetos, que closeDay() já faz com barH/dayStart/etc.).
var float dHi = na
var float dLo = na
var int dT = na
var float dC = na
var bool hadNewDay = false

// -------- DEBUG temporário: diagnóstico do 2W a desaparecer no 4H --------
var int debugLastDaySamples = 0
var int debugLastDayT = na
var int debugLastDayDow = na

// nakedLive/tappedLive precisam de estar definidos antes de closeDay(), que
// os lê para decidir se verifica toques "ao fecho do dia" (ver dentro da
// função). Movidos para aqui (antes só existiam mais abaixo, na secção de
// Taps) - Pine exige que uma função só referencie variáveis já declaradas
// antes dela no texto do script.
nakedLive  = nakedUpdateTick and not waitForClose
tappedLive = tappedUpdateTick and not waitForClose

// Processa UM dia já fechado (dHi_/dLo_/dT_/dC_/prevClose_, com todayH/L/V
// contendo as suas amostras horárias): fecho de mês/semana/2W, guarda o dia
// no array achatado barH/L/V, fecha 1D/2D/3D/5D, e verifica toques (naked ->
// tapped -> remoção) usando o alto/baixo DESTE dia especificamente. Chamada
// tanto pelo Caminho A (gráfico <= calcTF, 1x por dia real) como pelo
// Caminho B (gráfico > calcTF, em ciclo, 1x por cada dia real dentro do
// bloco maior do gráfico - ver mais abaixo). Crucial que os toques sejam
// verificados AQUI DENTRO (uma vez por dia real) e não só uma vez por barra
// do gráfico depois do ciclo do Caminho B acabar - bug encontrado: isso
// fazia com que, numa barra semanal com 7 dias processados de uma vez, só o
// ÚLTIMO desses 7 dias tivesse os seus toques verificados, deixando
// sobreviver "naked" muitos níveis que na realidade já tinham sido tocados
// nos outros 6 dias (confirmado pelo utilizador: coleções naked muito
// maiores no gráfico Semanal do que a diferença de histórico justificava).
closeDay(float dHi_, float dLo_, int dT_, float dC_, float prevClose_) =>
    n = array.size(dayStart)
    if n > 0
        prevT = array.get(dayCloseT, n - 1)
        newMonth = month(prevT) != month(dT_) or year(prevT) != year(dT_)
        if newMonth
            mStart = array.size(monthBoundary) > 0 ? array.get(monthBoundary, array.size(monthBoundary) - 1) : 0
            hStart = array.get(dayStart, mStart)
            [pocM, okM] = computePOC(barH, barL, barV, hStart, array.size(barH) - 1, rowSize)
            if okM and prevT >= startTime
                onPeriodClose(st1M, pocM)
            array.push(monthBoundary, n)

        newWeek = dayofweek(dT_) == dayofweek.monday and dayofweek(prevT) != dayofweek.monday
        if newWeek
            wStart = array.size(weekBoundary) > 0 ? array.get(weekBoundary, array.size(weekBoundary) - 1) : 0
            hwStart = array.get(dayStart, wStart)
            [pocW, okW] = computePOC(barH, barL, barV, hwStart, array.size(barH) - 1, rowSize)
            if okW and prevT >= startTime
                onPeriodClose(st1W, pocW)
            array.push(weekBoundary, n)
            wCount = array.size(weekBoundary)
            if weekParity(prevT) == 1 and wCount >= 2
                w2Start = array.get(weekBoundary, wCount - 2)
                hw2Start = array.get(dayStart, w2Start)
                [pocW2, okW2] = computePOC(barH, barL, barV, hw2Start, array.size(barH) - 1, rowSize)
                if okW2 and prevT >= startTime
                    onPeriodClose(st2W, pocW2)

    todayStartIdx = array.size(barH)
    if array.size(todayH) > 0
        hi2 = 0
        while hi2 < array.size(todayH)
            array.push(barH, array.get(todayH, hi2))
            array.push(barL, array.get(todayL, hi2))
            array.push(barV, array.get(todayV, hi2))
            hi2 += 1
    else
        array.push(barH, dHi_)
        array.push(barL, dLo_)
        array.push(barV, chV[1])
    array.push(dayStart, todayStartIdx)
    array.push(dayCloseT, dT_)
    n2 = array.size(dayStart)
    lastHourIdx = array.size(barH) - 1
    // 0 = Segunda, 1 = Terça, ..., 6 = Domingo. 2D/3D/5D reiniciam a
    // contagem em cada Segunda (tal como o 1W/2W acima) - o(s) dia(s) que
    // sobra(m) no fim da semana não se juntam à semana seguinte, são
    // descartados, e a contagem recomeça do zero na Segunda seguinte.
    dowIdx = (dayofweek(dT_) - dayofweek.monday + 7) % 7

    if dT_ >= startTime
        [poc1, ok1] = computePOC(barH, barL, barV, todayStartIdx, lastHourIdx, rowSize)
        if ok1
            onPeriodClose(st1D, poc1)
    if dowIdx % 2 == 1 and n2 >= 2 and dT_ >= startTime
        h2 = array.get(dayStart, n2 - 2)
        [poc2, ok2] = computePOC(barH, barL, barV, h2, lastHourIdx, rowSize)
        if ok2
            onPeriodClose(st2D, poc2)
    if dowIdx % 3 == 2 and n2 >= 3 and dT_ >= startTime
        h3 = array.get(dayStart, n2 - 3)
        [poc3, ok3] = computePOC(barH, barL, barV, h3, lastHourIdx, rowSize)
        if ok3
            onPeriodClose(st3D, poc3)
    if dowIdx == 4 and n2 >= 5 and dT_ >= startTime
        h5 = array.get(dayStart, n2 - 5)
        [poc5, ok5] = computePOC(barH, barL, barV, h5, lastHourIdx, rowSize)
        if ok5
            onPeriodClose(st5D, poc5)

    // Toques "ao fecho do dia" - usa o alto/baixo DESTE dia (dHi_/dLo_), não
    // do bloco maior do gráfico. Só corre se "Update on every tick" estiver
    // desligado (nakedLive/tappedLive tratam disso em tempo real, fora
    // desta função).
    if not nakedLive
        for i = 0 to array.size(allTF) - 1
            processNakedTaps(array.get(allTF, i), dHi_, dLo_, dC_, prevClose_)
    if not tappedLive
        for i = 0 to array.size(allTF) - 1
            processTappedTaps(array.get(allTF, i), dHi_, dLo_, dC_, prevClose_)

    array.clear(todayH)
    array.clear(todayL)
    array.clear(todayV)
    // O Pine não deixa reatribuir uma variável global escalar (debugLastDay*
    // são `var` fora desta função) de dentro de uma função - por isso
    // devolve os valores e cada chamador (Caminho A/B) atribui-os depois.
    [lastHourIdx - todayStartIdx + 1, dowIdx]

hadNewDay := false

// -------- Caminho A: gráfico <= calcTF (o caso normal) --------
// isNewCalcBar usava antes "cT != cT[1]" (cT vindo de um request.security
// normal a calcTF, lookahead_off) - mas esse fetch confirma o fecho de um
// período com um atraso extra face ao relógio real do gráfico (dados de um
// dia a ficarem etiquetados com a data do dia anterior), o que aqui seria
// especialmente problemático porque agrupa as próprias velas horárias no
// dia errado. timeframe.change(calcTF) deteta o novo período assim que o
// próprio gráfico o cruza, sem esse atraso.
isNewCalcBar = not useLowerTF and timeframe.change(calcTF) and not na(chH[1])

// Fecha o bloco horário em curso (barras do próprio gráfico agrupadas
// dentro da mesma hora real - só relevante quando not useIntrabar, ver
// secção de acumulação mais abaixo) ANTES do bloco de fecho do dia ler
// todayH/L/V. Importante para a ÚLTIMA hora do dia (23:00-23:59) ficar
// corretamente atribuída a ESSE dia, e não ao dia seguinte que está
// prestes a começar na mesma barra em que a hora muda.
if not useLowerTF and not useIntrabar and timeframe.change("60") and not na(hourH)
    array.push(todayH, hourH)
    array.push(todayL, hourL)
    array.push(todayV, hourV)
    hourH := na
    hourL := na
    hourV := 0.0

if isNewCalcBar
    // O dia que acabou de fechar: alto/baixo vêm do min/max das próprias
    // velas horárias já acumuladas (ou da barra do gráfico, se não houver
    // nenhuma); t é o timestamp da última barra do período (time[1]); c é
    // o close do símbolo resolvido nessa mesma barra (chC[1]).
    dLo := array.size(todayL) > 0 ? array.min(todayL) : chL[1]
    dHi := array.size(todayH) > 0 ? array.max(todayH) : chH[1]
    dT  := time[1]
    dC  := chC[1]
    [dbgSamples, dbgDow] = closeDay(dHi, dLo, dT, dC, lastDailyClose)
    lastDailyClose := dC
    debugLastDaySamples := dbgSamples
    debugLastDayT := dT
    debugLastDayDow := dbgDow
    hadNewDay := true

// Acumula as velas de 1h desta barra do gráfico (só no Caminho A - o
// Caminho B, mais abaixo, consome ibH/L/V/T/C de outra forma).
if not useLowerTF
    if useIntrabar and array.size(ibH) > 0
        // Gráfico mais grosso que 1h (ex. 4H, 1D): request.security_lower_tf
        // já dá velas de 1h reais, dentro de cada barra do gráfico.
        if bar_index != ibLastBarIdx
            ibConsumed := 0
            ibLastBarIdx := bar_index
        ibTotal = array.size(ibH)
        ii = ibConsumed
        while ii < ibTotal
            array.push(todayH, array.get(ibH, ii))
            array.push(todayL, array.get(ibL, ii))
            array.push(todayV, array.get(ibV, ii))
            ii += 1
        ibConsumed := ibTotal
    else
        // Gráfico a 1h ou mais fino (1min, 5min, 15min, 30min, 1H): não é
        // possível pedir "velas de 1h" via request.security_lower_tf (1h
        // deixaria de ser mais baixa que o gráfico). Em vez disso, agrega
        // as próprias barras do gráfico dentro da hora real em curso
        // (hourH/L/V, fechado no início desta secção pelo bloco
        // timeframe.change("60")), para dar a mesma granularidade horária
        // que os gráficos mais grossos conseguem.
        hourH := na(hourH) ? chH : math.max(hourH, chH)
        hourL := na(hourL) ? chL : math.min(hourL, chL)
        hourV += chV

// -------- Caminho B: gráfico > calcTF (ex. Semanal/Mensal com calc 1D) --------
// Uma barra do gráfico (ex. 1 semana) cobre VÁRIOS dias de uma vez. ibH/L/
// V/T/C (velas de 1h, buscadas mais acima) trazem TODAS as horas dentro
// dessa barra numa só chamada - por isso aqui percorre-se esse lote e
// agrupam-se as horas em dias PELOS SEUS PRÓPRIOS TIMESTAMPS (não por
// isNewCalcBar/timeframe.change, que só dispara 1x por barra do gráfico,
// ou seja 1x por semana - perderia os outros 6 dias). consumedCount/
// lastBarIdxSeen evitam reprocessar as mesmas horas em reexecuções da
// mesma barra em tempo real (mesmo padrão do Caminho A com ibConsumed).
// O último dia do lote (ainda a meio, sem se saber se já fechou) fica por
// fechar propositadamente - só é processado quando a PRÓXIMA hora, de um
// dia diferente, o confirmar como definitivamente terminado.
var int consumedCount = 0
var int lastBarIdxSeen = -1
var int accumDayIdx = -999999
var int accumDayT = na
var float accumDayC = na
if useLowerTF
    if bar_index != lastBarIdxSeen
        consumedCount := 0
        lastBarIdxSeen := bar_index
    ibTotal2 = array.size(ibH)
    idx = consumedCount
    while idx < ibTotal2
        hH = array.get(ibH, idx)
        hL = array.get(ibL, idx)
        hV = array.get(ibV, idx)
        hT = array.get(ibT, idx)
        hC = array.get(ibC, idx)
        hDayIdx = int(hT / 86400000)
        if array.size(todayH) > 0 and hDayIdx != accumDayIdx
            dLo := array.min(todayL)
            dHi := array.max(todayH)
            dT  := accumDayT
            dC  := accumDayC
            [dbgSamplesB, dbgDowB] = closeDay(dHi, dLo, dT, dC, lastDailyClose)
            lastDailyClose := dC
            debugLastDaySamples := dbgSamplesB
            debugLastDayT := dT
            debugLastDayDow := dbgDowB
            hadNewDay := true
        array.push(todayH, hH)
        array.push(todayL, hL)
        array.push(todayV, hV)
        accumDayIdx := hDayIdx
        accumDayT := hT
        accumDayC := hC
        idx += 1
    consumedCount := ibTotal2

// ---------------------------------------------------------------------------
// Taps (naked -> tapped -> remoção), em tempo real ou só ao fecho do bloco
// ---------------------------------------------------------------------------
if nakedLive
    for i = 0 to array.size(allTF) - 1
        processNakedTaps(array.get(allTF, i), high, low, close, close[1])
if tappedLive
    for i = 0 to array.size(allTF) - 1
        processTappedTaps(array.get(allTF, i), high, low, close, close[1])

// A seleção "mais próximo do preço" segue a mesma cadência que as taps: em
// tempo real se "Update on every tick" estiver ligado, senão só ao fecho do
// bloco de cálculo. É isto que mantém as linhas estáveis em vez de
// reordenarem a cada tick por causa de oscilações mínimas do preço.
if nakedLive
    updateNakedSel(st1D, sel1D, close)
    updateNakedSel(st2D, sel2D, close)
    updateNakedSel(st3D, sel3D, close)
    updateNakedSel(st5D, sel5D, close)
    updateNakedSel(st1W, sel1W, close)
    updateNakedSel(st2W, sel2W, close)
    updateNakedSel(st1M, sel1M, close)
if tappedLive
    selTp2D := updateTappedSel(st2D, close)
    selTp3D := updateTappedSel(st3D, close)
    selTp5D := updateTappedSel(st5D, close)
    selTp1W := updateTappedSel(st1W, close)
    selTp2W := updateTappedSel(st2W, close)
    selTp1M := updateTappedSel(st1M, close)

if hadNewDay
    if not nakedLive
        updateNakedSel(st1D, sel1D, dC)
        updateNakedSel(st2D, sel2D, dC)
        updateNakedSel(st3D, sel3D, dC)
        updateNakedSel(st5D, sel5D, dC)
        updateNakedSel(st1W, sel1W, dC)
        updateNakedSel(st2W, sel2W, dC)
        updateNakedSel(st1M, sel1M, dC)
    if not tappedLive
        selTp2D := updateTappedSel(st2D, dC)
        selTp3D := updateTappedSel(st3D, dC)
        selTp5D := updateTappedSel(st5D, dC)
        selTp1W := updateTappedSel(st1W, dC)
        selTp2W := updateTappedSel(st2W, dC)
        selTp1M := updateTappedSel(st1M, dC)

// ---------------------------------------------------------------------------
// Desenho: linhas no gráfico via line.new (extend.both, redesenhadas em cada
// barra "islast") SEM etiqueta no meio do gráfico - o nome/preço só aparece
// na price scale, através de um plot() invisível por slot
// (display=display.price_scale, não desenha nada no painel). Por isso "Line
// thickness = 0" desliga as linhas do gráfico mas mantém as etiquetas da
// price scale, tal como no original.
// ---------------------------------------------------------------------------
showLevels = lineThickness > 0

drawLevel(color col, float price) =>
    line.new(time[1], price, time, price, xloc = xloc.bar_time, extend = extend.both, color = col, style = line.style_dotted, width = lineThickness)

drawTF(TFState st, array<float> nakedSel, float tappedSel) =>
    if not na(st.lineNew)
        line.delete(st.lineNew)
    if array.size(st.nakedLines) > 0
        for i = 0 to array.size(st.nakedLines) - 1
            line.delete(array.get(st.nakedLines, i))
    array.clear(st.nakedLines)
    if not na(st.lineTapped)
        line.delete(st.lineTapped)

    if showLevels
        if st.showNew and st.hasNew
            st.lineNew := drawLevel(newColor, st.newPrice)
        if st.showNaked
            i = 0
            while i < array.size(nakedSel)
                p = array.get(nakedSel, i)
                if not na(p)
                    array.push(st.nakedLines, drawLevel(nakedColor, p))
                i += 1
        if st.showTapped and st.hasTapped and not na(tappedSel)
            st.lineTapped := drawLevel(tappedColor, tappedSel)

if barstate.islast
    // DEBUG temporário: tabela com estatísticas de histórico e das
    // coleções naked/tapped, para diagnosticar o 2W a desaparecer em
    // certos timeframes (ex. 4H). Controlada pelo input "Debug table"
    // (desligada por omissão) - remover depois de diagnosticado.
    if showDebugTable
        var table dbgTable = table.new(position.top_right, 2, 14, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.gray)
        table.cell(dbgTable, 0, 0, "DEBUG", text_color = color.white, bgcolor = color.new(color.blue, 30))
        table.cell(dbgTable, 1, 0, timeframe.period, text_color = color.white, bgcolor = color.new(color.blue, 30))
        table.cell(dbgTable, 0, 1, "Dias / semanas / meses", text_color = color.white)
        table.cell(dbgTable, 1, 1, str.tostring(array.size(dayStart)) + " / " + str.tostring(array.size(weekBoundary)) + " / " + str.tostring(array.size(monthBoundary)), text_color = color.white)
        table.cell(dbgTable, 0, 2, "Amostras últ. dia", text_color = color.white)
        table.cell(dbgTable, 1, 2, str.tostring(debugLastDaySamples), text_color = color.white)
        table.cell(dbgTable, 0, 3, "Data últ. dia / DOW", text_color = color.white)
        table.cell(dbgTable, 1, 3, str.tostring(debugLastDayT) + " / " + str.tostring(debugLastDayDow), text_color = color.white)
        table.cell(dbgTable, 0, 11, "Barra atual (time)", text_color = color.white)
        table.cell(dbgTable, 1, 11, str.tostring(time), text_color = color.white)
        table.cell(dbgTable, 0, 12, "st1D New (hasNew/preço)", text_color = color.white)
        table.cell(dbgTable, 1, 12, str.tostring(st1D.hasNew) + " / " + str.tostring(st1D.newPrice, "#.#"), text_color = color.white)
        // DEBUG: índice de dia (dias desde a epoch) dos últimos 6 dias já
        // processados, para comparar a SEQUÊNCIA real de dias entre o Caminho A
        // e o Caminho B - se um chart "saltar" ou "duplicar" um dia face ao
        // outro, isto aparece aqui como números que não avançam de 1 em 1 ou
        // que não coincidem entre os dois gráficos.
        nDbg = array.size(dayCloseT)
        seqStr = ""
        kMax = math.min(6, nDbg)
        startIdx = nDbg - kMax
        kk = startIdx
        while kk < nDbg
            dIdx = int(array.get(dayCloseT, kk) / 86400000)
            seqStr := seqStr + (kk > startIdx ? "," : "") + str.tostring(dIdx)
            kk += 1
        table.cell(dbgTable, 0, 13, "Últimos dias (idx)", text_color = color.white)
        table.cell(dbgTable, 1, 13, seqStr, text_color = color.white)
        table.cell(dbgTable, 0, 4, "1D naked/tapped", text_color = color.white)
        table.cell(dbgTable, 1, 4, str.tostring(array.size(st1D.nakedPrices)) + " / -", text_color = color.white)
        table.cell(dbgTable, 0, 5, "2D naked/tapped", text_color = color.white)
        table.cell(dbgTable, 1, 5, str.tostring(array.size(st2D.nakedPrices)) + " / " + str.tostring(array.size(st2D.tappedPrices)), text_color = color.white)
        table.cell(dbgTable, 0, 6, "5D naked/tapped", text_color = color.white)
        table.cell(dbgTable, 1, 6, str.tostring(array.size(st5D.nakedPrices)) + " / " + str.tostring(array.size(st5D.tappedPrices)), text_color = color.white)
        table.cell(dbgTable, 0, 7, "1W naked/tapped", text_color = color.white)
        table.cell(dbgTable, 1, 7, str.tostring(array.size(st1W.nakedPrices)) + " / " + str.tostring(array.size(st1W.tappedPrices)), text_color = color.white)
        table.cell(dbgTable, 0, 8, "2W naked/tapped", text_color = color.white)
        table.cell(dbgTable, 1, 8, str.tostring(array.size(st2W.nakedPrices)) + " / " + str.tostring(array.size(st2W.tappedPrices)), text_color = color.white)
        table.cell(dbgTable, 0, 9, "st2W.hasNew / newPrice", text_color = color.white)
        table.cell(dbgTable, 1, 9, str.tostring(st2W.hasNew) + " / " + str.tostring(st2W.newPrice, "#.#"), text_color = color.white)
        table.cell(dbgTable, 0, 10, "sel2W[0] / sel2W[1]", text_color = color.white)
        table.cell(dbgTable, 1, 10, str.tostring(array.get(sel2W, 0), "#.#") + " / " + str.tostring(array.get(sel2W, 1), "#.#"), text_color = color.white)

    drawTF(st1D, sel1D, float(na))
    drawTF(st2D, sel2D, selTp2D)
    drawTF(st3D, sel3D, selTp3D)
    drawTF(st5D, sel5D, selTp5D)
    drawTF(st1W, sel1W, selTp1W)
    drawTF(st2W, sel2W, selTp2W)
    drawTF(st1M, sel1M, selTp1M)

// -------- Etiquetas nativas na price scale (invisíveis no painel) --------
rawNew1D = st1D.showNew and st1D.hasNew ? st1D.newPrice : float(na)
rawNew2D = st2D.showNew and st2D.hasNew ? st2D.newPrice : float(na)
rawNew3D = st3D.showNew and st3D.hasNew ? st3D.newPrice : float(na)
rawNew5D = st5D.showNew and st5D.hasNew ? st5D.newPrice : float(na)
rawNew1W = st1W.showNew and st1W.hasNew ? st1W.newPrice : float(na)
rawNew2W = st2W.showNew and st2W.hasNew ? st2W.newPrice : float(na)
rawNew1M = st1M.showNew and st1M.hasNew ? st1M.newPrice : float(na)

plot(rawNew1D, title = "1D", color = na(rawNew1D) ? na : newColor, display = display.price_scale)
plot(rawNew2D, title = "2D", color = na(rawNew2D) ? na : newColor, display = display.price_scale)
plot(rawNew3D, title = "3D", color = na(rawNew3D) ? na : newColor, display = display.price_scale)
plot(rawNew5D, title = "5D", color = na(rawNew5D) ? na : newColor, display = display.price_scale)
plot(rawNew1W, title = "1W", color = na(rawNew1W) ? na : newColor, display = display.price_scale)
plot(rawNew2W, title = "2W", color = na(rawNew2W) ? na : newColor, display = display.price_scale)
plot(rawNew1M, title = "1M", color = na(rawNew1M) ? na : newColor, display = display.price_scale)

// sel1D..sel1M já são a seleção estável (ver secção de Taps acima) - só
// lemos as posições fixas do array aqui.
rawNk1D_1 = array.get(sel1D, 0)
rawNk1D_2 = array.get(sel1D, 1)
rawNk1D_3 = array.get(sel1D, 2)
rawNk2D_1 = array.get(sel2D, 0)
rawNk2D_2 = array.get(sel2D, 1)
rawNk2D_3 = array.get(sel2D, 2)
rawNk3D_1 = array.get(sel3D, 0)
rawNk3D_2 = array.get(sel3D, 1)
rawNk3D_3 = array.get(sel3D, 2)
rawNk5D_1 = array.get(sel5D, 0)
rawNk5D_2 = array.get(sel5D, 1)
rawNk5D_3 = array.get(sel5D, 2)
rawNk1W_1 = array.get(sel1W, 0)
rawNk1W_2 = array.get(sel1W, 1)
rawNk2W_1 = array.get(sel2W, 0)
rawNk2W_2 = array.get(sel2W, 1)
rawNk1M_1 = array.get(sel1M, 0)
rawNk1M_2 = array.get(sel1M, 1)

plot(rawNk1D_1, title = "1D", color = na(rawNk1D_1) ? na : nakedColor, display = display.price_scale)
plot(rawNk1D_2, title = "1D", color = na(rawNk1D_2) ? na : nakedColor, display = display.price_scale)
plot(rawNk1D_3, title = "1D", color = na(rawNk1D_3) ? na : nakedColor, display = display.price_scale)
plot(rawNk2D_1, title = "2D", color = na(rawNk2D_1) ? na : nakedColor, display = display.price_scale)
plot(rawNk2D_2, title = "2D", color = na(rawNk2D_2) ? na : nakedColor, display = display.price_scale)
plot(rawNk2D_3, title = "2D", color = na(rawNk2D_3) ? na : nakedColor, display = display.price_scale)
plot(rawNk3D_1, title = "3D", color = na(rawNk3D_1) ? na : nakedColor, display = display.price_scale)
plot(rawNk3D_2, title = "3D", color = na(rawNk3D_2) ? na : nakedColor, display = display.price_scale)
plot(rawNk3D_3, title = "3D", color = na(rawNk3D_3) ? na : nakedColor, display = display.price_scale)
plot(rawNk5D_1, title = "5D", color = na(rawNk5D_1) ? na : nakedColor, display = display.price_scale)
plot(rawNk5D_2, title = "5D", color = na(rawNk5D_2) ? na : nakedColor, display = display.price_scale)
plot(rawNk5D_3, title = "5D", color = na(rawNk5D_3) ? na : nakedColor, display = display.price_scale)
plot(rawNk1W_1, title = "1W", color = na(rawNk1W_1) ? na : nakedColor, display = display.price_scale)
plot(rawNk1W_2, title = "1W", color = na(rawNk1W_2) ? na : nakedColor, display = display.price_scale)
plot(rawNk2W_1, title = "2W", color = na(rawNk2W_1) ? na : nakedColor, display = display.price_scale)
