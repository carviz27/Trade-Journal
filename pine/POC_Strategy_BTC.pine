//@version=6
strategy("POC Strategy BTC (1D-1M)", shorttitle = "POC Strat", overlay = true, max_lines_count = 500, max_boxes_count = 200, max_labels_count = 500,
     initial_capital = 10000, currency = currency.USD,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 5,
     pyramiding = 1, commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 2, calc_on_every_tick = false, process_orders_on_close = false)

// ============================================================================
// Estratégia baseada no indicador "POC Multi-Timeframe (1D-1M)".
//
// Regra:
//   - POCs próximos agrupam-se em ZONAS (ver secção "POC zones").
//   - Zona ABAIXO do preço atual -> ordem LIMIT de COMPRA (long).
//   - Zona ACIMA  do preço atual -> ordem LIMIT de VENDA  (short).
//   - Preço dentro de uma zona -> essa zona não gera ordens.
//   - Todos os POCs são iguais (New/Naked/Tapped não interessa). Depois de
//     negociado, um POC fica bloqueado até o preço se afastar 'Re-arm
//     distance %' e depois pode voltar a ser usado (mesmo no próprio dia).
//   - Só UMA trade de cada vez: enquanto houver uma posição aberta não são
//     colocadas novas ordens; a próxima só é aberta depois de a atual sair
//     por Take Profit ou Stop Loss. Todas as ordens pendentes estão no mesmo
//     grupo OCA: quando uma é executada, as outras são canceladas logo (mesmo
//     dentro da mesma vela). Não há inversões de posição.
//   - Filtro RSI (ligado por defeito; um ou vários timeframes 1/5/15/30 min,
//     combinados com Any/All): só entra quando o preço toca a zona e o
//     RSI(14) está < 30 (long) ou > 70 (short), dentro de uma janela de N
//     minutos após o toque.
//   - Filtro de liquidações (ligado por defeito): só entra se as liquidações
//     de LONGS (para longs) / SHORTS (para shorts) numa vela de 5m (ou do
//     timeframe escolhido) - a atual ou uma das 3 anteriores - forem >= 20M USD. Dados = indicador Liquidations do
//     TradingView (tickers <CONTRATO>_LQSELL = longs / _LQBUY = shorts, campo volume), da
//     exchange do gráfico ou agregados. Nesse modo a
//     entrada é a mercado na barra seguinte do gráfico (no gráfico de 1m =
//     minuto seguinte; em 15m pode chegar até 15 min de atraso).
//   - Filtro de absorção (Big Trades, ligado por defeito): long só com um big
//     trade de VENDA perto da zona (faixa = zona +/- tolerância manual % ou
//     ATR) nos últimos N minutos; short com um big trade de COMPRA.
//   - Break-even: N velas de 1m seguidas em lucro -> stop na entrada.
//   - Modelo de entrada por defeito "Close beyond zone (1m)": depois do toque
//     e dos filtros, entra quando a 1.ª vela de 1m fecha acima (long) / abaixo
//     (short) da zona; stop no low/high do bounce; TP = 2R.
//   - Modelo "At zone": Stop Loss (para lá da zona) e Take Profit %.
//
// Só funciona em BTC (BTCUSDT, BTCUSD, BTCUSDT.P, XBTUSD, ...).
// O cálculo dos POCs é o mesmo do indicador original, mas corre sempre sobre
// velas de 1h num contexto próprio (request.security), por isso os POCs são
// iguais e completos em qualquer timeframe do gráfico (1m, 5m, ..., 1D).
// ============================================================================

grpStrat  = "Strategy"
grpData   = "Data source"
grpNew    = "Timeframes - New"
grpNaked  = "Timeframes - Naked"
grpTapped = "Timeframes - Tapped"
grpLevels = "Levels"
grpCalc   = "Calculation"

// ---------------------------------------------------------------------------
// Inputs da estratégia
// ---------------------------------------------------------------------------
tradeDir = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = grpStrat,
     tooltip = "Both: long nos POCs abaixo do preço e short nos POCs acima. Long only / Short only: só coloca as ordens desse lado.")
nTradeLevels = input.int(3, "POCs per timeframe", minval = 1, maxval = 20, group = grpStrat,
     tooltip = "Quantos POCs de cada timeframe (os mais próximos do preço) entram na estratégia. Todos os POCs são tratados por igual. Só são negociados os POCs que estão LIGADOS nos grupos 'Timeframes - New / Naked / Tapped': o que desligares deixa de aparecer E deixa de ser negociado.")
grpZone = "POC zones (clusters)"
clusterPct = input.float(0.5, "Cluster distance %", minval = 0.0, step = 0.05, group = grpZone,
     tooltip = "POCs a menos desta distância (%) do POC vizinho juntam-se na mesma zona. 0 = cada POC é uma zona sozinho (comportamento antigo).")
maxZonePct = input.float(1.5, "Max zone width %", minval = 0.0, step = 0.1, group = grpZone,
     tooltip = "Largura máxima de uma zona, para os POCs não se encadearem numa zona gigante.")
minPocsZone = input.int(1, "Min POCs per zone", minval = 1, maxval = 20, group = grpZone,
     tooltip = "1 = negoceia também POCs isolados. 2+ = só negoceia zonas de confluência com pelo menos N POCs.")
entryMode = input.string("Near edge", "Entry at", options = ["Near edge", "Zone middle"], group = grpZone,
     tooltip = "Near edge: entra no primeiro POC da zona que o preço toca. Zone middle: entra no meio da zona.")
sizeByCount = input.bool(false, "Scale size by POC count", group = grpZone,
     tooltip = "Tamanho = base % x nº de POCs da zona (até ao multiplicador máximo).")
maxSizeMult = input.int(3, "Max size multiplier", minval = 1, maxval = 10, group = grpZone)
basePct = input.float(5.0, "Base size (% equity)", minval = 0.1, step = 0.5, group = grpZone)
showZones = input.bool(true, "Show zones", group = grpZone)
grpRsi = "RSI filter"
useRsi = input.bool(true, "Require RSI", group = grpRsi,
     tooltip = "ON: só entra quando o preço toca a zona E o RSI (dos timeframes ligados) está oversold (long) ou overbought (short). A entrada é a mercado, na abertura da barra seguinte do gráfico - quanto menor o gráfico, mais precisa. OFF: ordens limit nas zonas, sem filtro.")
rsi1On  = input.bool(true,  "1m",  group = grpRsi, inline = "rsiTF")
rsi5On  = input.bool(true,  "5m",  group = grpRsi, inline = "rsiTF")
rsi15On = input.bool(false, "15m", group = grpRsi, inline = "rsiTF")
rsi30On = input.bool(false, "30m", group = grpRsi, inline = "rsiTF",
     tooltip = "Timeframes do RSI a usar (podes ligar vários). O RSI de cada um é avaliado minuto a minuto, em formação (o valor que verias ao vivo nesse timeframe).")
rsiCombine = input.string("Any", "Combine timeframes", options = ["Any", "All"], group = grpRsi,
     tooltip = "Any: basta UM dos timeframes ligados estar oversold/overbought. All: TODOS os ligados têm de estar ao mesmo tempo.")
rsiLen = input.int(14, "RSI length", minval = 2, group = grpRsi)
rsiOB  = input.float(70, "Overbought (shorts acima de)", group = grpRsi)
rsiOS  = input.float(30, "Oversold (longs abaixo de)", group = grpRsi)
preLimit = input.bool(true, "Limit at POC if already confirmed", group = grpRsi,
     tooltip = "ON: se o RSI e as liquidações JÁ estiverem confirmados antes de o preço chegar à zona, fica uma ordem LIMIT no POC e a entrada é exatamente no nível. Se ainda não estiverem confirmados, funciona como antes (espera pelo toque + confirmação e entra a mercado).")
rsiWindow = input.int(3, "Minutes after touch to wait for RSI", minval = 0, maxval = 120, group = grpRsi,
     tooltip = "Depois de o preço tocar a zona, durante quantos minutos o sinal fica à espera de o RSI chegar ao extremo. 0 = o RSI tem de estar no extremo no próprio minuto do toque. O sinal é cancelado se o preço chegar ao stop loss da zona.")

grpLiq = "Liquidations filter"
useLiq = input.bool(true, "Require liquidations", group = grpLiq,
     tooltip = "ON: só entra se as liquidações dos últimos X minutos forem >= ao mínimo - LONG liquidations para longs, SHORT liquidations para shorts. Combina com o filtro RSI (os dois têm de confirmar no mesmo minuto).")
liqSource = input.string("Aggregated (all exchanges)", "Liquidations source", options = ["Chart exchange", "Aggregated (all exchanges)", "Custom"], group = grpLiq,
     tooltip = "Chart exchange: liquidações da exchange/contrato do gráfico (ex.: BYBIT:BTCUSDT.P -> BYBIT:BTCUSDT.P_LQSELL / _LQBUY). Aggregated: todas as exchanges suportadas (CRYPTO:BTC_LQSELL / _LQBUY), igual ao indicador 'Liquidations' do TradingView em modo agregado. Custom: escreves os símbolos abaixo. Os dados são os mesmos do indicador Liquidations do TradingView. O gráfico tem de ser um contrato perpétuo/futuro (.P), não spot, para 'Chart exchange'.")
liqLongSym  = input.symbol("", "Custom long liquidations symbol", group = grpLiq, active = liqSource == "Custom",
     tooltip = "Só para 'Custom'. Ex.: BYBIT:BTCUSDT.P_LQSELL (longs liquidados = venda forçada).")
liqShortSym = input.symbol("", "Custom short liquidations symbol", group = grpLiq, active = liqSource == "Custom",
     tooltip = "Só para 'Custom'. Ex.: BYBIT:BTCUSDT.P_LQBUY (shorts liquidados = compra forçada).")
liqUnits = input.string("Auto", "Values are in", options = ["Auto", "USD", "BTC"], group = grpLiq,
     tooltip = "Consoante a exchange, o TradingView dá as liquidações em BTC ou em USD/USDT. Auto: deteta pelo tipo de volume do símbolo de liquidações e converte para USD (BTC x preço) quando é preciso.")
liqMin = input.float(5000000.0, "Minimum liquidations (USD)", minval = 0, step = 1000000, group = grpLiq)
liq1On  = input.bool(true,  "1m",  group = grpLiq, inline = "liqTF")
liq5On  = input.bool(true,  "5m",  group = grpLiq, inline = "liqTF")
liq15On = input.bool(false, "15m", group = grpLiq, inline = "liqTF")
liq30On = input.bool(false, "30m", group = grpLiq, inline = "liqTF")
liq60On = input.bool(false, "1h",  group = grpLiq, inline = "liqTF",
     tooltip = "Timeframe das velas de liquidações (1m/5m/15m/30m/1h), como no indicador Liquidations nesse timeframe. Podes ligar vários.")
liqCombine = input.string("Any", "Combine timeframes", options = ["Any", "All"], group = grpLiq,
     tooltip = "Any: basta UM dos timeframes ligados cumprir. All: TODOS têm de cumprir.")
liqLookback = input.int(6, "Bars back", minval = 0, maxval = 20, group = grpLiq,
     tooltip = "A trade abre se a vela de liquidações ATUAL ou uma das N velas anteriores (do timeframe escolhido, ex.: 5m) tiver liquidações >= ao mínimo. Cada vela é contada sozinha (não se somam velas). 0 = só a vela atual.")

reuseTouched = input.bool(true, "Re-use touched POCs", group = grpStrat,
     tooltip = "ON: um POC/zona já negociado volta a poder ser usado (mesmo no próprio dia) depois de o preço se afastar dele pelo menos 'Re-arm distance %'. OFF: cada POC só é negociado uma vez.")
rearmPct = input.float(0.5, "Re-arm distance %", minval = 0.0, step = 0.05, group = grpStrat,
     tooltip = "Distância a que o preço tem de se afastar de um POC já negociado para ele voltar a receber ordem. Evita entrar várias vezes seguidas no mesmo toque.")
slPct = input.float(1.0, "Stop loss % (beyond far edge of zone)", minval = 0.0, step = 0.1, group = grpStrat,
     tooltip = "O stop fica esta % para lá da extremidade OPOSTA da zona. 0 = sem stop loss.")
tpPct = input.float(2.0, "Take profit %", minval = 0.0, step = 0.1, group = grpStrat, tooltip = "0 = sem take profit (sai só por stop ou inversão).")
showDiag = input.bool(true, "Diagnostic table", group = grpStrat,
     tooltip = "Mostra no canto inferior direito o estado dos filtros na última vela: zonas armadas, sinais à espera, RSI e a maior vela de liquidações (longs/shorts) - para perceber porque é que uma trade não abriu.")
tradeFrom = input.time(timestamp("2023-09-01T01:00:00"), "Trade from", group = grpStrat)
tradeTo   = input.time(timestamp("2099-01-01T00:00:00"), "Trade until", group = grpStrat)

// ---------------------------------------------------------------------------
// Inputs do indicador original
// ---------------------------------------------------------------------------
realVolumeOnly = input.bool(true, "Real volume only", group = grpData,
     tooltip = "Se o símbolo resolvido só tiver volume sintético (tick volume), para com erro.")

cryptoOpt = input.string("(chart's exchange:quote)", "Crypto / Exchange:Quote", group = grpData,
     options = ["(chart's exchange:quote)", "BINANCE:USDT", "BINANCE:USDT.P", "BINANCE:USD",
     "BYBIT:USDT", "BYBIT:USDT.P", "BYBIT:USD", "COINBASE:USD", "COINBASE:USDT",
     "BITFINEX:USD", "BITSTAMP:USD", "OKX:USDT", "OKX:USDT.P", "KRAKEN:USD",
     "GATEIO:USDT", "MEXC:USDT", "Custom"],
     tooltip = "Fonte do volume para calcular os POCs. As ordens são sempre executadas no símbolo do gráfico.")
cryptoCustom = input.string("", "Crypto / Custom ticker (ex.: BYBIT:BTCUSDT.P)", group = grpData)

startTime = input.time(timestamp("2023-09-01T01:00:00"), "Start date", group = grpData,
     tooltip = "Os níveis só são calculados a partir desta data.")
rowSize = input.int(24, "Row size", minval = 2, maxval = 200, group = grpData)

newColor   = input.color(color.new(color.gray, 0), "New - color", group = grpNew, inline = "new0")
newShow1D  = input.bool(true, "1D", group = grpNew, inline = "new1")
newShow2D  = input.bool(true, "2D", group = grpNew, inline = "new1")
newShow3D  = input.bool(true, "3D", group = grpNew, inline = "new1")
newShow5D  = input.bool(true, "5D", group = grpNew, inline = "new1")
newShow1W  = input.bool(true, "1W", group = grpNew, inline = "new2")
newShow2W  = input.bool(true, "2W", group = grpNew, inline = "new2")
newShow1M  = input.bool(true, "1M", group = grpNew, inline = "new2")

nakedColor  = input.color(color.new(#7f6fa2, 0), "Naked - color", group = grpNaked, inline = "nk0")
nakedShow1D = input.bool(true, "1D", group = grpNaked, inline = "nk1")
nakedShow2D = input.bool(true, "2D", group = grpNaked, inline = "nk1")
nakedShow3D = input.bool(true, "3D", group = grpNaked, inline = "nk1")
nakedShow5D = input.bool(true, "5D", group = grpNaked, inline = "nk1")
nakedShow1W = input.bool(true, "1W", group = grpNaked, inline = "nk2")
nakedShow2W = input.bool(true, "2W", group = grpNaked, inline = "nk2")
nakedShow1M = input.bool(true, "1M", group = grpNaked, inline = "nk2")
nakedUpdateTick = input.bool(false, "Update on every tick", group = grpNaked)

tappedColor  = input.color(color.new(#9c87be, 0), "Tapped - color", group = grpTapped, inline = "tp0")
tappedShow1D = input.bool(true, "1D", group = grpTapped, inline = "tp1")
tappedShow2D = input.bool(false, "2D", group = grpTapped, inline = "tp1")
tappedShow3D = input.bool(true, "3D", group = grpTapped, inline = "tp1")
tappedShow5D = input.bool(true, "5D", group = grpTapped, inline = "tp1")
tappedShow1W = input.bool(true, "1W", group = grpTapped, inline = "tp2")
tappedShow2W = input.bool(true, "2W", group = grpTapped, inline = "tp2")
tappedShow1M = input.bool(true, "1M", group = grpTapped, inline = "tp2")
tappedUpdateTick = input.bool(false, "Update on every tick", group = grpTapped)
countTapsBy = input.string("Whole candle", "Count taps by", options = ["Whole candle", "Candle close through"], group = grpTapped)
tapsToRemove = input.int(2, "Taps to remove", minval = 1, maxval = 20, group = grpTapped)

lineThickness = input.int(1, "Line thickness", minval = 0, maxval = 4, group = grpLevels)

calcTF = input.timeframe("1D", "Timeframe", group = grpCalc)
waitForClose = input.bool(false, "Wait for timeframe closes", group = grpCalc)

grpBE = "Break-even"
useBE = input.bool(true, "Move stop to break-even", group = grpBE,
     tooltip = "Depois de N velas de 1 minuto SEGUIDAS a fechar em lucro (close acima da entrada num long / abaixo num short - a cor da vela não interessa), o stop loss passa para o preço de entrada. Se uma vela fechar sem lucro, a contagem recomeça.")
beBars = input.int(5, "Consecutive 1m candles in profit", minval = 1, maxval = 120, group = grpBE)
beOffsetPct = input.float(0.0, "BE offset %", minval = 0.0, step = 0.01, group = grpBE,
     tooltip = "0 = stop exatamente no preço de entrada. Ex.: 0.05 = stop 0.05% para o lado do lucro (cobre comissões).")

grpAbs = "Absorption (Big Trades)"
useAbs = input.bool(true, "Require absorption", group = grpAbs,
     tooltip = "Só entra se houver um BIG TRADE contra a direção da trade perto da zona (absorção): LONG precisa de um big trade de VENDA (bolha roxa), SHORT de um big trade de COMPRA (bolha verde). Mesma lógica do indicador Big Trades: cada vela intrabar (ex.: 15s) é um 'print'; close < open = venda, close >= open = compra.")
absTF = input.timeframe("15S", "Prints resolution", group = grpAbs,
     tooltip = "Resolução das velas intrabar usadas como prints. Tem de ser menor que o gráfico (é ajustada automaticamente se não for). Segundos exigem plano pago.")
absWindow = input.int(15, "Time window (minutes)", minval = 1, maxval = 240, group = grpAbs,
     tooltip = "O big trade tem de ter acontecido nos últimos N minutos antes da entrada (inclui a aproximação à zona).")
absTolMode = input.string("ATR", "Proximity band", options = ["ATR", "Manual %"], group = grpAbs,
     tooltip = "A bolha conta se a vela do print tocar a zona alargada por esta tolerância (para os dois lados: um pouco antes da zona e um pouco para lá dela).")
absTolPct = input.float(0.2, "Manual tolerance %", minval = 0.0, step = 0.05, group = grpAbs, active = absTolMode == "Manual %")
absAtrTF  = input.timeframe("5", "ATR timeframe", group = grpAbs, active = absTolMode == "ATR")
absAtrLen = input.int(14, "ATR length", minval = 1, group = grpAbs, active = absTolMode == "ATR")
absAtrMult = input.float(0.5, "ATR multiplier", minval = 0.0, step = 0.1, group = grpAbs, active = absTolMode == "ATR")
absSizeMode = input.string("Relative", "Size filter", options = ["Relative", "Absolute"], group = grpAbs,
     tooltip = "Relative: volume do print >= K x média dos prints anteriores (adapta-se à hora/volatilidade). Absolute: volume mínimo fixo.")
absRelMult = input.float(5.0, "Relative: K x average", minval = 1.0, step = 0.5, group = grpAbs, active = absSizeMode == "Relative")
absRelLen  = input.int(200, "Relative: average of last N prints", minval = 10, maxval = 5000, group = grpAbs, active = absSizeMode == "Relative")
absMin     = input.float(20, "Absolute: minimum size", minval = 0.0, group = grpAbs, active = absSizeMode == "Absolute")
absUnits   = input.string("BTC", "Absolute: units", options = ["BTC", "USDT"], group = grpAbs, active = absSizeMode == "Absolute")
absShowBubbles = input.bool(true, "Show big trade bubbles", group = grpAbs,
     tooltip = "Desenha no gráfico os big trades que a estratégia deteta (verde = compra, roxo = venda). O TradingView guarda no máximo 500 etiquetas, por isso só as mais recentes ficam visíveis.")
grpBub = "Big trade bubbles (aspeto igual ao indicador Big Trades)"
bubMarker    = input.string("Circle", "Marker", options = ["Circle", "Square", "Diamond", "Text"], group = grpBub)
bubHollow    = input.bool(false, "Hollow fill", group = grpBub)
bubShowText  = input.bool(true, "Show text", group = grpBub)
bubStdevMult = input.float(2.5, "Standard Dev.", minval = 0.1, step = 0.1, group = grpBub)
bubMinPx     = input.float(0.20, "Minimum size", minval = 0.01, step = 0.05, group = grpBub)
bubMaxPx     = input.float(2.00, "Maximum size", minval = 0.01, step = 0.05, group = grpBub)
bubMinOp     = input.int(10, "Minimum opacity", minval = 0, maxval = 100, group = grpBub)
bubMaxOp     = input.int(40, "Maximum opacity", minval = 0, maxval = 100, group = grpBub)
bubAskColor  = input.color(color.new(#00c853, 0), "Buy bubble color (Ask)", group = grpBub)
bubBidColor  = input.color(color.new(#7e57c2, 0), "Sell bubble color (Bid)", group = grpBub)
bubTextSize  = input.int(12, "Text size", minval = 6, maxval = 48, group = grpBub)
bubTextColor = input.color(color.white, "Text color (trade size number)", group = grpBub)

grpEntry = "Entry model"
entryModel = input.string("Close beyond zone (1m)", "Entry model", options = ["Close beyond zone (1m)", "At zone (limit/market)"], group = grpEntry,
     tooltip = "Close beyond zone (1m): depois de o preço tocar a zona e os filtros confirmarem, só entra quando a PRIMEIRA vela de 1 minuto FECHAR acima da zona (long) / abaixo da zona (short). Stop no low (long) / high (short) feito desde o toque na zona; take profit em R múltiplos. At zone: modelo antigo (limit no POC ou mercado após confirmação, stop % para lá da zona, TP %).")
rrMult = input.float(2.0, "Take profit (R multiple)", minval = 0.1, step = 0.1, group = grpEntry,
     tooltip = "Só no modelo 'Close beyond zone'. TP = entrada + R x (entrada - stop) num long. Recalculado com o preço real de entrada.")
closeWait = input.int(30, "Max minutes to wait for the close beyond the zone", minval = 1, maxval = 600, group = grpEntry,
     tooltip = "Depois do toque na zona, quanto tempo espera pela vela de 1m a fechar do outro lado da zona. Os filtros (RSI/liquidações/absorção) têm de confirmar pelo menos uma vez entre o toque e a vela de entrada. O sinal é cancelado se passar este tempo, ou se o preço romper a zona até ao 'Stop loss %' (nesse modelo o 'Stop loss %' serve só para invalidar a zona; o stop real é o low/high do bounce).")
slBufferPct = input.float(0.0, "Stop buffer % (below the low / above the high)", minval = 0.0, step = 0.01, group = grpEntry)
bounceBeyond = input.bool(true, "Bounce candle must close beyond the zone", group = grpEntry,
     tooltip = "Padrão de entrada (long): uma vela de 1m VERMELHA toca a zona (pode deixar wick) e a vela SEGUINTE fecha VERDE -> entrada. ON: essa vela verde também tem de fechar acima do topo da zona. Short: vela VERDE toca a zona e a seguinte fecha VERMELHA (abaixo da zona, se ON). Uma vela que toca e fecha logo do outro lado NÃO dá entrada.")

// ---------------------------------------------------------------------------
// Só BTC
// ---------------------------------------------------------------------------
isBTC = syminfo.basecurrency == "BTC" or syminfo.basecurrency == "XBT"
if slPct == 0 and tpPct == 0
    runtime.error("Define pelo menos Stop loss % ou Take profit %: só se abre uma nova trade depois de a atual sair por TP ou SL.")
if not isBTC
    runtime.error("Esta estratégia só funciona em BTC. Símbolo atual: " + syminfo.tickerid)

// ---------------------------------------------------------------------------
// Resolução do símbolo de dados + validação de volume real
// ---------------------------------------------------------------------------
resolveCrypto() =>
    string t = syminfo.tickerid
    if cryptoOpt == "Custom" and str.length(cryptoCustom) > 0
        t := cryptoCustom
    else if cryptoOpt != "(chart's exchange:quote)" and cryptoOpt != "Custom"
        parts = str.split(cryptoOpt, ":")
        if array.size(parts) == 2
            t := array.get(parts, 0) + ":" + syminfo.basecurrency + array.get(parts, 1)
    t

targetSymbol = resolveCrypto()

cVolType = request.security(targetSymbol, calcTF, syminfo.volumetype)
if cVolType == "N/A"
    runtime.error("Símbolo " + targetSymbol + " não tem dados de volume.")
if realVolumeOnly and cVolType == "tick"
    runtime.error("Símbolo " + targetSymbol + " só fornece tick volume. Desliga 'Real volume only' ou muda a exchange.")

// ---------------------------------------------------------------------------
// Estado por timeframe
// ---------------------------------------------------------------------------
type TFState
    string tfName
    bool showNew
    bool showNaked
    bool showTapped
    int maxVisible
    bool hasTapped
    float newPrice = na
    bool hasNew = false
    array<float> nakedPrices
    array<float> tappedPrices
    array<int> tappedTaps
    array<float> tradeSel

computePOC(array<float> hArr, array<float> lArr, array<float> vArr, int fromIdx, int toIdx, int rows) =>
    float pHi = na
    float pLo = na
    for i = fromIdx to toIdx
        hi = array.get(hArr, i)
        lo = array.get(lArr, i)
        pHi := na(pHi) ? hi : math.max(pHi, hi)
        pLo := na(pLo) ? lo : math.min(pLo, lo)
    if pHi > pLo
        bins = array.new<float>(rows, 0.0)
        binH = (pHi - pLo) / rows
        for i = fromIdx to toIdx
            hi  = array.get(hArr, i)
            lo  = array.get(lArr, i)
            vol = array.get(vArr, i)
            rng = hi - lo
            if rng <= 0
                idx = int(math.min(rows - 1, math.max(0, math.floor((lo - pLo) / binH))))
                array.set(bins, idx, array.get(bins, idx) + vol)
            else
                for j = 0 to rows - 1
                    binLo = pLo + j * binH
                    binHi = binLo + binH
                    overlap = math.min(hi, binHi) - math.max(lo, binLo)
                    if overlap > 0
                        array.set(bins, j, array.get(bins, j) + vol * (overlap / rng))
        bestIdx = 0
        bestVol = array.get(bins, 0)
        for j = 1 to rows - 1
            v = array.get(bins, j)
            if v > bestVol
                bestVol := v
                bestIdx := j
        [pLo + (bestIdx + 0.5) * binH, true]
    else
        [float(na), false]

weekParity(int t) =>
    int(math.floor((t - 345600000) / 604800000.0)) % 2

onPeriodClose(TFState st, float poc) =>
    if st.hasNew
        array.push(st.nakedPrices, st.newPrice)
    st.newPrice := poc
    st.hasNew := true

checkTouch(float p, float hi, float lo, float cl, float prevCl) =>
    countTapsBy == "Whole candle" ? (hi >= p and lo <= p) :
         (not na(prevCl) and ((cl >= p and prevCl < p) or (cl <= p and prevCl > p)))

processNakedTaps(TFState st, float hi, float lo, float cl, float prevCl) =>
    i = array.size(st.nakedPrices) - 1
    while i >= 0
        p = array.get(st.nakedPrices, i)
        if checkTouch(p, hi, lo, cl, prevCl)
            array.remove(st.nakedPrices, i)
            if st.hasTapped
                array.push(st.tappedPrices, p)
                array.push(st.tappedTaps, 0)
        i -= 1

processTappedTaps(TFState st, float hi, float lo, float cl, float prevCl) =>
    if st.hasTapped
        i = array.size(st.tappedPrices) - 1
        while i >= 0
            p = array.get(st.tappedPrices, i)
            if checkTouch(p, hi, lo, cl, prevCl)
                cnt = array.get(st.tappedTaps, i) + 1
                if cnt >= tapsToRemove
                    array.remove(st.tappedPrices, i)
                    array.remove(st.tappedTaps, i)
                else
                    array.set(st.tappedTaps, i, cnt)
            i -= 1

selectClosest(array<float> prices, int maxN, float refPrice) =>
    size = array.size(prices)
    sel = array.new<float>()
    if size > 0 and maxN > 0
        idxArr = array.new<int>()
        i = 0
        while i < size
            array.push(idxArr, i)
            i += 1
        lim = math.min(maxN, size)
        k = 0
        while k < lim
            bestJ = k
            bestD = math.abs(array.get(prices, array.get(idxArr, k)) - refPrice)
            j = k + 1
            while j < size
                d = math.abs(array.get(prices, array.get(idxArr, j)) - refPrice)
                if d < bestD
                    bestD := d
                    bestJ := j
                j += 1
            if bestJ != k
                tmp = array.get(idxArr, k)
                array.set(idxArr, k, array.get(idxArr, bestJ))
                array.set(idxArr, bestJ, tmp)
            array.push(sel, array.get(prices, array.get(idxArr, k)))
            k += 1
    sel

updateNakedSel(TFState st, array<float> dest, float refPrice) =>
    sel = st.showNaked ? selectClosest(st.nakedPrices, st.maxVisible, refPrice) : array.new<float>()
    n = array.size(dest)
    i = 0
    while i < n
        array.set(dest, i, i < array.size(sel) ? array.get(sel, i) : float(na))
        i += 1

updateTappedSel(TFState st, float refPrice) =>
    sel = st.showTapped and st.hasTapped ? selectClosest(st.tappedPrices, 1, refPrice) : array.new<float>()
    array.size(sel) > 0 ? array.get(sel, 0) : float(na)

newTF(string name, bool showNew, bool showNaked, bool showTapped, int maxVisible, bool hasTapped) =>
    TFState.new(tfName = name, showNew = showNew, showNaked = showNaked, showTapped = showTapped,
         maxVisible = maxVisible, hasTapped = hasTapped,
         nakedPrices = array.new<float>(), tappedPrices = array.new<float>(), tappedTaps = array.new<int>(),
         tradeSel = array.new<float>())

var TFState st1D = newTF("1D", newShow1D, nakedShow1D, tappedShow1D, 3, true)
var TFState st2D = newTF("2D", newShow2D, nakedShow2D, tappedShow2D, 3, true)
var TFState st3D = newTF("3D", newShow3D, nakedShow3D, tappedShow3D, 3, true)
var TFState st5D = newTF("5D", newShow5D, nakedShow5D, tappedShow5D, 3, true)
var TFState st1W = newTF("1W", newShow1W, nakedShow1W, tappedShow1W, 2, true)
var TFState st2W = newTF("2W", newShow2W, nakedShow2W, tappedShow2W, 2, true)
var TFState st1M = newTF("1M", newShow1M, nakedShow1M, tappedShow1M, 2, true)
var array<TFState> allTF = array.from(st1D, st2D, st3D, st5D, st1W, st2W, st1M)

var array<float> sel1D = array.new<float>(3, na)
var array<float> sel2D = array.new<float>(3, na)
var array<float> sel3D = array.new<float>(3, na)
var array<float> sel5D = array.new<float>(3, na)
var array<float> sel1W = array.new<float>(2, na)
var array<float> sel2W = array.new<float>(2, na)
var array<float> sel1M = array.new<float>(2, na)

var float selTp1D = na
var float selTp2D = na
var float selTp3D = na
var float selTp5D = na
var float selTp1W = na
var float selTp2W = na
var float selTp1M = na

// ---------------------------------------------------------------------------
// Motor dos POCs - corre num contexto PRÓPRIO de velas de 1 hora
// (request.security(targetSymbol, "60", ...)), e não nas velas do gráfico.
// Assim o histórico disponível para construir os volume profiles é o das
// velas de 1h (meses/anos), e os POCs são os mesmos em QUALQUER timeframe do
// gráfico (1m, 5m, 15m, 1h, 4h...). Antes, em 1m/5m o gráfico só tinha uns
// dias/semanas de velas e os POCs de semanas/meses quase não existiam.
// ---------------------------------------------------------------------------
nakedLive  = nakedUpdateTick and not waitForClose
tappedLive = tappedUpdateTick and not waitForClose

type PocEngine
    array<float> barH
    array<float> barL
    array<float> barV
    array<int>   dayStart
    array<int>   dayCloseT
    array<int>   monthBoundary
    array<int>   weekBoundary
    array<float> todayH
    array<float> todayL
    array<float> todayV
    float lastDailyClose = na
    int   dayCount = 0
    float dayClose = na
    array<TFState> tfs

// Resultado enviado do contexto de 1h para o gráfico (só os níveis mais
// próximos do preço, para não copiar arrays enormes em cada vela).
type TFOut
    float newPrice = na
    bool  hasNew = false
    array<float> naked
    array<float> tapped

type PocOut
    array<TFOut> tfs
    int   dayCount = 0
    float dayClose = na

POC_OUT_N = 25

closeDayE(PocEngine e, float dHi_, float dLo_, int dT_, float dC_, float prevClose_) =>
    n = array.size(e.dayStart)
    if n > 0
        prevT = array.get(e.dayCloseT, n - 1)
        newMonth = month(prevT) != month(dT_) or year(prevT) != year(dT_)
        if newMonth
            mStart = array.size(e.monthBoundary) > 0 ? array.get(e.monthBoundary, array.size(e.monthBoundary) - 1) : 0
            hStart = array.get(e.dayStart, mStart)
            [pocM, okM] = computePOC(e.barH, e.barL, e.barV, hStart, array.size(e.barH) - 1, rowSize)
            if okM and prevT >= startTime
                onPeriodClose(array.get(e.tfs, 6), pocM)
            array.push(e.monthBoundary, n)

        newWeek = dayofweek(dT_) == dayofweek.monday and dayofweek(prevT) != dayofweek.monday
        if newWeek
            wStart = array.size(e.weekBoundary) > 0 ? array.get(e.weekBoundary, array.size(e.weekBoundary) - 1) : 0
            hwStart = array.get(e.dayStart, wStart)
            [pocW, okW] = computePOC(e.barH, e.barL, e.barV, hwStart, array.size(e.barH) - 1, rowSize)
            if okW and prevT >= startTime
                onPeriodClose(array.get(e.tfs, 4), pocW)
            array.push(e.weekBoundary, n)
            wCount = array.size(e.weekBoundary)
            if weekParity(prevT) == 1 and wCount >= 2
                w2Start = array.get(e.weekBoundary, wCount - 2)
                hw2Start = array.get(e.dayStart, w2Start)
                [pocW2, okW2] = computePOC(e.barH, e.barL, e.barV, hw2Start, array.size(e.barH) - 1, rowSize)
                if okW2 and prevT >= startTime
                    onPeriodClose(array.get(e.tfs, 5), pocW2)

    todayStartIdx = array.size(e.barH)
    hi2 = 0
    while hi2 < array.size(e.todayH)
        array.push(e.barH, array.get(e.todayH, hi2))
        array.push(e.barL, array.get(e.todayL, hi2))
        array.push(e.barV, array.get(e.todayV, hi2))
        hi2 += 1
    array.push(e.dayStart, todayStartIdx)
    array.push(e.dayCloseT, dT_)
    n2 = array.size(e.dayStart)
    lastHourIdx = array.size(e.barH) - 1
    dowIdx = (dayofweek(dT_) - dayofweek.monday + 7) % 7

    if dT_ >= startTime
        [poc1, ok1] = computePOC(e.barH, e.barL, e.barV, todayStartIdx, lastHourIdx, rowSize)
        if ok1
            onPeriodClose(array.get(e.tfs, 0), poc1)
    if dowIdx % 2 == 1 and n2 >= 2 and dT_ >= startTime
        h2 = array.get(e.dayStart, n2 - 2)
        [poc2, ok2] = computePOC(e.barH, e.barL, e.barV, h2, lastHourIdx, rowSize)
        if ok2
            onPeriodClose(array.get(e.tfs, 1), poc2)
    if dowIdx % 3 == 2 and n2 >= 3 and dT_ >= startTime
        h3 = array.get(e.dayStart, n2 - 3)
        [poc3, ok3] = computePOC(e.barH, e.barL, e.barV, h3, lastHourIdx, rowSize)
        if ok3
            onPeriodClose(array.get(e.tfs, 2), poc3)
    if dowIdx == 4 and n2 >= 5 and dT_ >= startTime
        h5 = array.get(e.dayStart, n2 - 5)
        [poc5, ok5] = computePOC(e.barH, e.barL, e.barV, h5, lastHourIdx, rowSize)
        if ok5
            onPeriodClose(array.get(e.tfs, 3), poc5)

    if not nakedLive
        for i = 0 to array.size(e.tfs) - 1
            processNakedTaps(array.get(e.tfs, i), dHi_, dLo_, dC_, prevClose_)
    if not tappedLive
        for i = 0 to array.size(e.tfs) - 1
            processTappedTaps(array.get(e.tfs, i), dHi_, dLo_, dC_, prevClose_)

    array.clear(e.todayH)
    array.clear(e.todayL)
    array.clear(e.todayV)


// Um passo do motor = uma vela de 1h do símbolo de dados.
pocEngineStep() =>
    var PocEngine e = PocEngine.new(barH = array.new<float>(), barL = array.new<float>(), barV = array.new<float>(),
         dayStart = array.new<int>(), dayCloseT = array.new<int>(), monthBoundary = array.new<int>(),
         weekBoundary = array.new<int>(), todayH = array.new<float>(), todayL = array.new<float>(),
         todayV = array.new<float>(),
         tfs = array.from(
             newTF("1D", newShow1D, nakedShow1D, tappedShow1D, 3, true),
             newTF("2D", newShow2D, nakedShow2D, tappedShow2D, 3, true),
             newTF("3D", newShow3D, nakedShow3D, tappedShow3D, 3, true),
             newTF("5D", newShow5D, nakedShow5D, tappedShow5D, 3, true),
             newTF("1W", newShow1W, nakedShow1W, tappedShow1W, 2, true),
             newTF("2W", newShow2W, nakedShow2W, tappedShow2W, 2, true),
             newTF("1M", newShow1M, nakedShow1M, tappedShow1M, 2, true)))
    pT = time[1]
    pC = close[1]
    bool changed = false
    // Primeira vela de 1h de um novo dia (calcTF) -> fecha o dia anterior.
    if timeframe.change(calcTF) and array.size(e.todayH) > 0
        dLo = array.min(e.todayL)
        dHi = array.max(e.todayH)
        closeDayE(e, dHi, dLo, pT, pC, e.lastDailyClose)
        e.lastDailyClose := pC
        e.dayCount += 1
        e.dayClose := pC
        changed := true
    array.push(e.todayH, high)
    array.push(e.todayL, low)
    array.push(e.todayV, volume)
    // "Update on every tick": toques verificados vela de 1h a vela de 1h.
    if nakedLive or tappedLive
        int before = 0
        for st in e.tfs
            before += array.size(st.nakedPrices) * 1000 + array.size(st.tappedPrices)
        if nakedLive
            for st in e.tfs
                processNakedTaps(st, high, low, close, pC)
        if tappedLive
            for st in e.tfs
                processTappedTaps(st, high, low, close, pC)
        int after = 0
        for st in e.tfs
            after += array.size(st.nakedPrices) * 1000 + array.size(st.tappedPrices)
        if after != before
            changed := true
    // Só envia o objeto quando os POCs mudam (ou na última vela). Enviar em
    // todas as velas fazia o TradingView guardar uma cópia por vela do
    // gráfico -> "Memory limits exceeded" (RE10139) em 1m/5m.
    PocOut out = na
    if changed or barstate.islast
        out := PocOut.new(tfs = array.new<TFOut>(), dayCount = e.dayCount, dayClose = e.dayClose)
        for st in e.tfs
            array.push(out.tfs, TFOut.new(st.newPrice, st.hasNew,
                 selectClosest(st.nakedPrices, POC_OUT_N, close), selectClosest(st.tappedPrices, POC_OUT_N, close)))
    out

// gaps_on: o gráfico só recebe o objeto na vela em que ele chega (não é
// repetido nas ~60 velas de 1m de cada hora). Entre envios mantém-se o último.
PocOut pocOut = request.security(targetSymbol, "60", pocEngineStep(), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)

// Copia o resultado para o estado do gráfico (seleção, desenho e trading).
var int lastDayCount = -1
var float dC = na
bool hadNewDay = false
if not na(pocOut)
    for k = 0 to 6
        o  = array.get(pocOut.tfs, k)
        sk = array.get(allTF, k)
        sk.newPrice := o.newPrice
        sk.hasNew := o.hasNew
        sk.nakedPrices := o.naked
        sk.tappedPrices := o.tapped
    if pocOut.dayCount != lastDayCount
        hadNewDay := true
        dC := na(pocOut.dayClose) ? close : pocOut.dayClose
        lastDayCount := pocOut.dayCount

// ---------------------------------------------------------------------------
// Seleção dos níveis mostrados
// ---------------------------------------------------------------------------
refreshNaked(float ref) =>
    updateNakedSel(st1D, sel1D, ref)
    updateNakedSel(st2D, sel2D, ref)
    updateNakedSel(st3D, sel3D, ref)
    updateNakedSel(st5D, sel5D, ref)
    updateNakedSel(st1W, sel1W, ref)
    updateNakedSel(st2W, sel2W, ref)
    updateNakedSel(st1M, sel1M, ref)

if nakedLive
    refreshNaked(close)
if tappedLive
    selTp1D := updateTappedSel(st1D, close)
    selTp2D := updateTappedSel(st2D, close)
    selTp3D := updateTappedSel(st3D, close)
    selTp5D := updateTappedSel(st5D, close)
    selTp1W := updateTappedSel(st1W, close)
    selTp2W := updateTappedSel(st2W, close)
    selTp1M := updateTappedSel(st1M, close)

if hadNewDay
    if not nakedLive
        refreshNaked(dC)
    if not tappedLive
        selTp1D := updateTappedSel(st1D, dC)
        selTp2D := updateTappedSel(st2D, dC)
        selTp3D := updateTappedSel(st3D, dC)
        selTp5D := updateTappedSel(st5D, dC)
        selTp1W := updateTappedSel(st1W, dC)
        selTp2W := updateTappedSel(st2W, dC)
        selTp1M := updateTappedSel(st1M, dC)

// ============================================================================
// ESTRATÉGIA: zonas de POCs (clusters) com ordens limit
// ============================================================================
// Os POCs candidatos (todos os tipos, de todos os timeframes ligados) são
// ordenados por preço e agrupados em ZONAS: POCs seguidos a menos de
// "Cluster distance %" uns dos outros ficam na mesma zona (até um máximo de
// "Max zone width %"). Cada zona é tratada como UM só nível:
//   - zona toda abaixo do preço -> 1 ordem long  (na extremidade de cima ou no meio)
//   - zona toda acima  do preço -> 1 ordem short (na extremidade de baixo ou no meio)
//   - preço DENTRO da zona      -> nenhuma ordem nova dessa zona (evita o
//     compra/vende/compra/vende enquanto o preço anda no meio dos POCs)
//   - stop loss fica para lá da extremidade OPOSTA da zona (+ buffer %), por
//     isso andar dentro da zona não tira a posição.
//   - depois de a zona ser tocada, TODOS os POCs dela ficam bloqueados até o
//     preço se afastar 'Re-arm distance %' (ver "Re-use touched POCs").

// traded: BLOQUEIO temporário de preços de POCs (chave = só o preço, seja
// qual for o tipo ou timeframe) e de zonas já executadas. Com "Re-use touched
// POCs" ligado, o bloqueio sai quando o preço se afasta 'Re-arm distance %'.
var map<string, bool> traded = map.new<string, bool>()
var array<string> lockKeys = array.new<string>()
var array<float>  lockPx   = array.new<float>()
// filled: IDs de ordens já executadas (permanente, para nunca cancelar o
// SL/TP de uma entrada aberta). fillCnt: nº de vezes que cada zona foi
// executada, para cada nova entrada na mesma zona ter um ID diferente.
var map<string, bool> filled = map.new<string, bool>()
var map<string, int>  fillCnt = map.new<string, int>()
var map<string, float> tpById = map.new<string, float>()
var bool needSel = true
var array<string> pendIds  = array.new<string>()
var array<string> pendBase = array.new<string>()
var array<float>  pendPx   = array.new<float>()
var array<string> pendMem  = array.new<string>()
var array<bool>   pendLong = array.new<bool>()
var array<float>  pendSL   = array.new<float>()
var array<float>  pendLo   = array.new<float>()
var array<float>  pendHi   = array.new<float>()
var array<int>    pendCnt  = array.new<int>()
// Sinais à espera do RSI (zona tocada, RSI ainda não no extremo).
var array<string> trgBase  = array.new<string>()
var array<bool>   trgLong  = array.new<bool>()
var array<float>  trgEntry = array.new<float>()
var array<float>  trgSL    = array.new<float>()
var array<float>  trgLo    = array.new<float>()
var array<float>  trgHi    = array.new<float>()
var array<string> trgMem   = array.new<string>()
var array<int>    trgCnt   = array.new<int>()
var array<int>    trgExp   = array.new<int>()
var array<float>  trgExt   = array.new<float>()   // low (long) / high (short) desde o toque
var array<bool>   trgConf  = array.new<bool>()    // filtros já confirmaram?
var array<int>    trgConfExp = array.new<int>()   // limite para os filtros confirmarem
var array<string> trgLbl   = array.new<string>()  // texto dos filtros que confirmaram
var array<bool>   trgPrevRT = array.new<bool>()   // vela anterior: vermelha (long) / verde (short) a tocar a zona
var map<string, float> slById = map.new<string, float>()

trgRemove(int i) =>
    array.remove(trgBase, i)
    array.remove(trgLong, i)
    array.remove(trgEntry, i)
    array.remove(trgSL, i)
    array.remove(trgLo, i)
    array.remove(trgHi, i)
    array.remove(trgMem, i)
    array.remove(trgCnt, i)
    array.remove(trgExp, i)
    array.remove(trgExt, i)
    array.remove(trgConf, i)
    array.remove(trgConfExp, i)
    array.remove(trgLbl, i)
    array.remove(trgPrevRT, i)

trgClear() =>
    array.clear(trgBase)
    array.clear(trgLong)
    array.clear(trgEntry)
    array.clear(trgSL)
    array.clear(trgLo)
    array.clear(trgHi)
    array.clear(trgMem)
    array.clear(trgCnt)
    array.clear(trgExp)
    array.clear(trgExt)
    array.clear(trgConf)
    array.clear(trgConfExp)
    array.clear(trgLbl)
    array.clear(trgPrevRT)

// Filtro RSI multi-timeframe. Os passos de avaliação são velas de 1 minuto
// (as da barra do gráfico via request.security_lower_tf, ou a própria barra
// se o gráfico for de 1m ou menos). Para cada timeframe ligado (1/5/15/30m)
// mantém-se um RSI próprio, calculado à mão a partir desses closes de 1m:
// RMA (Wilder, igual ao ta.rsi) dos ganhos/perdas até à última vela FECHADA
// desse timeframe + a variação até ao minuto atual = RSI em formação, o mesmo
// que se veria ao vivo nesse timeframe.
chartSec = timeframe.in_seconds(timeframe.period)
if useRsi and not (rsi1On or rsi5On or rsi15On or rsi30On)
    runtime.error("Liga pelo menos um timeframe do RSI (1m/5m/15m/30m) ou desliga 'Require RSI'.")

rsMins = array.from(1, 5, 15, 30)
rsOn   = array.from(rsi1On, rsi5On, rsi15On, rsi30On)
var array<float> rsPrev = array.new<float>(4, na)
var array<float> rsLast = array.new<float>(4, na)
var array<float> rsAvgG = array.new<float>(4, na)
var array<float> rsAvgL = array.new<float>(4, na)
var array<float> rsSumG = array.new<float>(4, 0.0)
var array<float> rsSumL = array.new<float>(4, 0.0)
var array<int>   rsN    = array.new<int>(4, 0)
var array<int>   rsCur  = array.new<int>(4, -1)
curRsi = array.new<float>(4, na)

// Alimenta os RSIs com um close de 1m (t = hora de abertura desse minuto).
rsiFeed(int t, float c) =>
    for i = 0 to 3
        if array.get(rsOn, i)
            bid = int(math.floor(t / (array.get(rsMins, i) * 60000.0)))
            cur = array.get(rsCur, i)
            if cur != bid
                if cur != -1
                    lastC = array.get(rsLast, i)
                    prev  = array.get(rsPrev, i)
                    if not na(prev)
                        ch = lastC - prev
                        g = math.max(ch, 0)
                        l = math.max(-ch, 0)
                        n = array.get(rsN, i)
                        if n < rsiLen
                            array.set(rsSumG, i, array.get(rsSumG, i) + g)
                            array.set(rsSumL, i, array.get(rsSumL, i) + l)
                            array.set(rsN, i, n + 1)
                            if n + 1 == rsiLen
                                array.set(rsAvgG, i, array.get(rsSumG, i) / rsiLen)
                                array.set(rsAvgL, i, array.get(rsSumL, i) / rsiLen)
                        else
                            array.set(rsAvgG, i, (array.get(rsAvgG, i) * (rsiLen - 1) + g) / rsiLen)
                            array.set(rsAvgL, i, (array.get(rsAvgL, i) * (rsiLen - 1) + l) / rsiLen)
                    array.set(rsPrev, i, lastC)
                array.set(rsCur, i, bid)
            array.set(rsLast, i, c)
            prev2 = array.get(rsPrev, i)
            aG = array.get(rsAvgG, i)
            float r = na
            if not na(prev2) and not na(aG)
                chNow = c - prev2
                dG = (aG * (rsiLen - 1) + math.max(chNow, 0)) / rsiLen
                dL = (array.get(rsAvgL, i) * (rsiLen - 1) + math.max(-chNow, 0)) / rsiLen
                r := dL == 0 ? 100.0 : dG == 0 ? 0.0 : 100 - 100 / (1 + dG / dL)
            array.set(curRsi, i, r)

// RSI confirma a direção? Devolve [ok, texto com os RSIs que confirmaram].
rsiCheck(bool lg) =>
    int nOn = 0
    int nHit = 0
    string lbl = ""
    for i = 0 to 3
        if array.get(rsOn, i)
            nOn += 1
            r = array.get(curRsi, i)
            if not na(r) and (lg ? r < rsiOS : r > rsiOB)
                nHit += 1
                lbl := lbl + " " + str.tostring(array.get(rsMins, i)) + "m:" + str.tostring(r, "#")
    [nOn > 0 and (rsiCombine == "Any" ? nHit > 0 : nHit == nOn), lbl]

// ---------------------------------------------------------------------------
// Filtro de liquidações: lê as liquidações de 1 minuto dos símbolos
// configurados e guarda-as (hora, valor em USD) num buffer. Em cada minuto
// de avaliação agrupa-as em velas do timeframe escolhido (ex.: 5m) e vê a
// vela atual e as N anteriores, só com minutos já fechados até esse minuto
// (sem olhar para o futuro).
// ---------------------------------------------------------------------------
// Tickers de liquidações (formato da biblioteca oficial TradingView/Request):
//   por exchange: "<EXCHANGE>:<CONTRATO>_LQSELL" (longs liquidados) / "_LQBUY" (shorts liquidados)
//   agregado:     "CRYPTO:<COIN>_LQSELL" / "CRYPTO:<COIN>_LQBUY"
// Confirmado com dados reais (Bybit, queda forte): LQSELL 3.64M vs LQBUY
// 0.06M -> LQSELL = longs liquidados (venda forçada).
// O valor liquidado está no campo VOLUME desses símbolos.
lqCoin = str.replace(str.upper(syminfo.basecurrency), "XTVC", "")
lqLongTicker  = liqSource == "Custom" ? liqLongSym  : liqSource == "Aggregated (all exchanges)" ? "CRYPTO:" + lqCoin + "_LQSELL" : ticker.standard(syminfo.tickerid) + "_LQSELL"
lqShortTicker = liqSource == "Custom" ? liqShortSym : liqSource == "Aggregated (all exchanges)" ? "CRYPTO:" + lqCoin + "_LQBUY"  : ticker.standard(syminfo.tickerid) + "_LQBUY"
if useLiq and liqSource == "Custom" and (liqLongSym == "" or liqShortSym == "")
    runtime.error("Liquidations source = Custom: define os dois símbolos (ou escolhe 'Chart exchange' / 'Aggregated').")
if useLiq and liqSource == "Chart exchange" and not str.endswith(syminfo.ticker, ".P") and syminfo.type != "futures"
    runtime.error("Liquidations source = Chart exchange precisa de um gráfico de contrato perpétuo/futuro (ex.: BYBIT:BTCUSDT.P). Gráfico atual: " + syminfo.tickerid + ". Muda o gráfico ou usa 'Aggregated'.")

// Unidades: "base" = BTC (converte com o preço), "quote" = já em USD/USDT.
string lqVolType = ""
if useLiq
    lqVolType := request.security(lqLongTicker, "1D", syminfo.volumetype, ignore_invalid_symbol = true)
lqInBase = liqUnits == "BTC" or (liqUnits == "Auto" and lqVolType == "base")
if useLiq and not (liq1On or liq5On or liq15On or liq30On or liq60On)
    runtime.error("Liga pelo menos uma janela de liquidações (1m/5m/15m/30m/1h).")

lqMins = array.from(1, 5, 15, 30, 60)
lqOn   = array.from(liq1On, liq5On, liq15On, liq30On, liq60On)
var array<int>   lqLongT  = array.new<int>()
var array<float> lqLongV  = array.new<float>()
var array<int>   lqShortT = array.new<int>()
var array<float> lqShortV = array.new<float>()
var int lqLastLongT  = 0
var int lqLastShortT = 0
var bool lqGotData = false


lqIngest(array<int> tArr, array<float> vArr, array<int> bufT, array<float> bufV, int lastT) =>
    int newLast = lastT
    n = array.size(tArr)
    if n > 0
        for i = 0 to n - 1
            t = array.get(tArr, i)
            v = array.get(vArr, i)
            if t > newLast and not na(v)
                array.push(bufT, t)
                array.push(bufV, lqInBase ? v * close : v)
                newLast := t
    // Mantém só a última 1h (+ margem).
    while array.size(bufT) > 0 and array.get(bufT, 0) < time - (liqLookback + 2) * 3600000
        array.shift(bufT)
        array.shift(bufV)
    newLast

if useLiq
    lLT = array.new<int>()
    lLV = array.new<float>()
    lST = array.new<int>()
    lSV = array.new<float>()
    if timeframe.in_seconds(timeframe.period) > 60
        lLT := request.security_lower_tf(lqLongTicker,  "1", time,   ignore_invalid_symbol = true)
        lLV := request.security_lower_tf(lqLongTicker,  "1", volume, ignore_invalid_symbol = true)
        lST := request.security_lower_tf(lqShortTicker, "1", time,   ignore_invalid_symbol = true)
        lSV := request.security_lower_tf(lqShortTicker, "1", volume, ignore_invalid_symbol = true)
    else
        [lt1, lv1] = request.security(lqLongTicker,  "1", [time, volume], ignore_invalid_symbol = true)
        [st1, sv1] = request.security(lqShortTicker, "1", [time, volume], ignore_invalid_symbol = true)
        if not na(lt1)
            array.push(lLT, lt1)
            array.push(lLV, lv1)
        if not na(st1)
            array.push(lST, st1)
            array.push(lSV, sv1)
    lqLastLongT  := lqIngest(lLT, lLV, lqLongT, lqLongV, lqLastLongT)
    lqLastShortT := lqIngest(lST, lSV, lqShortT, lqShortV, lqLastShortT)
    if array.size(lqLongT) > 0 or array.size(lqShortT) > 0
        lqGotData := true

// Liquidações confirmam a direção no minuto que abriu em mT?
// Long -> liquidações de LONGS; short -> liquidações de SHORTS.
// Velas de liquidações alinhadas ao relógio (ex.: 5m = 10:00, 10:05, ...).
// Ok se a vela que contém o minuto mT (só com os minutos já fechados até mT)
// OU uma das 'liqLookback' velas anteriores tiver liquidações >= liqMin.
// Long -> liquidações de LONGS; short -> liquidações de SHORTS.
liqCheck(bool lg, int mT) =>
    bufT = lg ? lqLongT : lqShortT
    bufV = lg ? lqLongV : lqShortV
    int nOn = 0
    int nHit = 0
    string lbl = ""
    nb = array.size(bufT)
    for j = 0 to 4
        if array.get(lqOn, j)
            nOn += 1
            tfMs = array.get(lqMins, j) * 60000
            curB = int(math.floor(mT / tfMs))
            sums = array.new<float>(liqLookback + 1, 0.0)
            if nb > 0
                for i = 0 to nb - 1
                    t = array.get(bufT, i)
                    if t <= mT
                        k = curB - int(math.floor(t / tfMs))
                        if k >= 0 and k <= liqLookback
                            array.set(sums, k, array.get(sums, k) + array.get(bufV, i))
            best = array.max(sums)
            if best >= liqMin
                nHit += 1
                lbl := lbl + " " + str.tostring(array.get(lqMins, j)) + "m:" + str.tostring(best / 1000000, "#.#") + "M"
    [nOn > 0 and (liqCombine == "Any" ? nHit > 0 : nHit == nOn), lbl]

// Maior vela de liquidações (atual ou N anteriores) entre os timeframes ligados.
liqBestAll(bool lg, int mT) =>
    bufT = lg ? lqLongT : lqShortT
    bufV = lg ? lqLongV : lqShortV
    float bestAll = 0.0
    nb = array.size(bufT)
    for j = 0 to 4
        if array.get(lqOn, j)
            tfMs = array.get(lqMins, j) * 60000
            curB = int(math.floor(mT / tfMs))
            sums = array.new<float>(liqLookback + 1, 0.0)
            if nb > 0
                for i = 0 to nb - 1
                    t = array.get(bufT, i)
                    if t <= mT
                        k = curB - int(math.floor(t / tfMs))
                        if k >= 0 and k <= liqLookback
                            array.set(sums, k, array.get(sums, k) + array.get(bufV, i))
            bestAll := math.max(bestAll, array.max(sums))
    bestAll

// ---------------------------------------------------------------------------
// Absorção (Big Trades): prints = velas intrabar (ex.: 15s). Guarda os prints
// "grandes" dos últimos minutos (hora, mínima, máxima, venda/compra, tamanho).
// ---------------------------------------------------------------------------
absChartSec = timeframe.in_seconds(timeframe.period)
absMaxSec = absChartSec > 3600 ? 3600 : absChartSec > 1800 ? 1800 : absChartSec > 900 ? 900 : absChartSec > 300 ? 300 : absChartSec > 60 ? 60 : absChartSec > 30 ? 30 : absChartSec > 15 ? 15 : absChartSec > 5 ? 5 : absChartSec > 1 ? 1 : 0
if useAbs and absMaxSec == 0
    runtime.error("Absorption: o gráfico já está em 1S; não há resolução intrabar mais baixa para os prints.")
absEffSec = math.min(timeframe.in_seconds(absTF), absMaxSec)
absEffTF = absEffSec <= 1 ? "1S" : absEffSec <= 5 ? "5S" : absEffSec <= 15 ? "15S" : absEffSec <= 30 ? "30S" : absEffSec <= 60 ? "1" : absEffSec <= 300 ? "5" : absEffSec <= 900 ? "15" : absEffSec <= 1800 ? "30" : "60"

var array<int>   bpT    = array.new<int>()
var array<float> bpLo   = array.new<float>()
var array<float> bpHi   = array.new<float>()
var array<bool>  bpSell = array.new<bool>()
var array<float> bpSize = array.new<float>()
var array<float> absVolHist = array.new<float>()
// Estatística dos tamanhos (log) - igual ao indicador Big Trades, só para o
// tamanho/opacidade das bolhas.
var array<float> bubLogSizes = array.new<float>()
bubHaveStats = array.size(bubLogSizes) >= 100
bubLogMean   = bubHaveStats ? array.avg(bubLogSizes) : na
bubLogStdev  = bubHaveStats ? array.stdev(bubLogSizes) : na
bubLabelStyle() =>
    bubMarker == "Circle" ? label.style_circle : bubMarker == "Square" ? label.style_square : bubMarker == "Diamond" ? label.style_diamond : label.style_label_center
bubBucketSize(float px) =>
    px < 8 ? size.tiny : px < 14 ? size.small : px < 20 ? size.normal : px < 28 ? size.large : size.huge
bubBucketTextSize(float px) =>
    px < 14.4 ? size.tiny : px < 22.8 ? size.small : px < 31.2 ? size.normal : px < 39.6 ? size.large : size.huge
var int absLastT = 0

float absAtr = na
if useAbs and absTolMode == "ATR"
    absAtr := request.security(syminfo.tickerid, absAtrTF, ta.atr(absAtrLen))

if useAbs
    [pO, pH, pL, pC, pV, pT] = request.security_lower_tf(syminfo.tickerid, absEffTF, [open, high, low, close, volume, time])
    nP = array.size(pC)
    if nP > 0
        for i = 0 to nP - 1
            t = array.get(pT, i)
            if t > absLastT
                absLastT := t
                v = array.get(pV, i)
                c = array.get(pC, i)
                array.push(bubLogSizes, math.log(v + 1))
                if array.size(bubLogSizes) > 2000
                    array.shift(bubLogSizes)
                float avgPrev = array.size(absVolHist) >= 10 ? array.avg(absVolHist) : na
                bool big = absSizeMode == "Relative" ? (not na(avgPrev) and avgPrev > 0 and v >= absRelMult * avgPrev) : ((absUnits == "USDT" ? v * c : v) >= absMin)
                if big
                    isSellP = c < array.get(pO, i)
                    array.push(bpT, t)
                    array.push(bpLo, array.get(pL, i))
                    array.push(bpHi, array.get(pH, i))
                    array.push(bpSell, isSellP)
                    array.push(bpSize, v)
                    if absShowBubbles
                        // Mesmo desenho do indicador Big Trades: bolha sem texto +
                        // número centrado por cima (fundo transparente).
                        float z = bubHaveStats and bubLogStdev > 0 ? (math.log(v + 1) - bubLogMean) / bubLogStdev : na
                        float sizeNorm = na(z) ? 0.5 : math.max(0.0, math.min(1.0, z / bubStdevMult))
                        int opacityPct = int(math.round(bubMinOp + sizeNorm * (bubMaxOp - bubMinOp)))
                        color baseColor = isSellP ? bubBidColor : bubAskColor
                        color fillColor = bubHollow ? color.new(baseColor, 100) : color.new(baseColor, 100 - math.max(0, math.min(100, opacityPct)))
                        float pxLo = math.max(2.0, bubMinPx * 5)
                        float pxHi = math.max(pxLo + 0.5, bubMaxPx * 5)
                        string lblSize = bubBucketSize(pxLo + sizeNorm * (pxHi - pxLo))
                        string txtLblSize = bubBucketTextSize(bubTextSize)
                        string txt = (bubShowText or bubMarker == "Text") ? str.tostring(v, "#") : ""
                        if bubMarker == "Text"
                            label.new(bar_index, c, text = txt, style = label.style_label_center, size = txtLblSize,
                                 color = color.new(color.black, 100), textcolor = bubTextColor)
                        else
                            label.new(bar_index, c, text = "", style = bubLabelStyle(), size = lblSize,
                                 color = fillColor, textcolor = bubTextColor)
                            if txt != ""
                                label.new(bar_index, c, text = txt, style = label.style_label_center, size = txtLblSize,
                                     color = color.new(color.black, 100), textcolor = bubTextColor)
                array.push(absVolHist, v)
                if array.size(absVolHist) > absRelLen
                    array.shift(absVolHist)
    while array.size(bpT) > 0 and array.get(bpT, 0) < time - (absWindow + 5) * 60000
        array.shift(bpT)
        array.shift(bpLo)
        array.shift(bpHi)
        array.shift(bpSell)
        array.shift(bpSize)

// Há absorção para esta zona no minuto que abriu em mT?
// Long -> big trade de VENDA; short -> big trade de COMPRA; vela do print a
// tocar [zoneLo - tol, zoneHi + tol]; nos últimos absWindow minutos (só prints
// já fechados até ao fim desse minuto).
absCheck(bool lg, int mT, float zLo_, float zHi_) =>
    float tol = absTolMode == "ATR" ? (na(absAtr) ? 0.0 : absAtr * absAtrMult) : (zLo_ + zHi_) / 2 * absTolPct / 100
    bandLo = zLo_ - tol
    bandHi = zHi_ + tol
    tEnd = mT + 60000
    tStart = tEnd - absWindow * 60000
    float best = 0.0
    n = array.size(bpT)
    if n > 0
        for i = 0 to n - 1
            t = array.get(bpT, i)
            if t >= tStart and t < tEnd and array.get(bpSell, i) == lg
                if array.get(bpHi, i) >= bandLo and array.get(bpLo, i) <= bandHi
                    best := math.max(best, array.get(bpSize, i))
    [best > 0, best > 0 ? " ABS " + str.tostring(best, "#.##") : ""]

useConfirm = useRsi or useLiq or useAbs
newEntry = entryModel == "Close beyond zone (1m)"
// O modelo novo usa sempre o caminho "toque -> sinal -> entrada" (sem ordens
// limit no POC), mesmo sem filtros ligados.
useTrig = useConfirm or newEntry

m1H = array.new<float>()
m1L = array.new<float>()
m1C = array.new<float>()
m1T = array.new<int>()
m1O = array.new<float>()
if useTrig or useBE
    if chartSec > 60
        m1H := request.security_lower_tf(syminfo.tickerid, "1", high)
        m1L := request.security_lower_tf(syminfo.tickerid, "1", low)
        m1C := request.security_lower_tf(syminfo.tickerid, "1", close)
        m1O := request.security_lower_tf(syminfo.tickerid, "1", open)
        m1T := request.security_lower_tf(syminfo.tickerid, "1", time)
    else
        array.push(m1H, high)
        array.push(m1L, low)
        array.push(m1C, close)
        array.push(m1O, open)
        array.push(m1T, time)

lockKey(string k, float p) =>
    if not map.contains(traded, k)
        map.put(traded, k, true)
        array.push(lockKeys, k)
        array.push(lockPx, p)

inWindow = time >= tradeFrom and time <= tradeTo
allowLong  = tradeDir != "Short only"
allowShort = tradeDir != "Long only"

// 0) IDs de entradas realmente executadas (trades abertas + trades que
//    fecharam desde a última barra, ex.: entrou e saiu na mesma vela).
var int lastClosedCount = 0
execIds = array.new<string>()
if strategy.opentrades > 0
    for t = 0 to strategy.opentrades - 1
        array.push(execIds, strategy.opentrades.entry_id(t))
if strategy.closedtrades > lastClosedCount
    for t = lastClosedCount to strategy.closedtrades - 1
        array.push(execIds, strategy.closedtrades.entry_id(t))
    lastClosedCount := strategy.closedtrades

// 1) Ordens da barra anterior que foram executadas -> bloqueia a zona e
//    todos os POCs que a compõem.
if array.size(pendIds) > 0
    for i = 0 to array.size(pendIds) - 1
        p = array.get(pendPx, i)
        if array.includes(execIds, array.get(pendIds, i)) and not map.contains(filled, array.get(pendIds, i))
            base = array.get(pendBase, i)
            map.put(filled, array.get(pendIds, i), true)
            map.put(fillCnt, base, (map.contains(fillCnt, base) ? map.get(fillCnt, base) : 0) + 1)
            lockKey(base, p)
            members = str.split(array.get(pendMem, i), ";")
            for m in members
                lockKey(m, str.tonumber(str.substring(m, 2)))
            needSel := true

// 1b) Re-arm: liberta POCs/zonas de que o preço já se afastou o suficiente.
if reuseTouched and array.size(lockKeys) > 0
    for i = array.size(lockKeys) - 1 to 0
        lp = array.get(lockPx, i)
        if na(lp) or math.abs(close - lp) / lp * 100 >= rearmPct
            map.remove(traded, array.get(lockKeys, i))
            array.remove(lockKeys, i)
            array.remove(lockPx, i)
            needSel := true

// 1c) Sinais: percorre os minutos (velas de 1m) desta barra do gráfico.
//     Toque numa zona "armada" (da barra anterior) -> nasce um sinal.
//     Modelo "Close beyond zone (1m)": o sinal guarda o low (long) / high
//     (short) desde o toque; os filtros têm de confirmar (a partir do toque);
//     entra quando a PRIMEIRA vela de 1m fecha acima da zona (long) / abaixo
//     (short) -> stop nesse low/high, TP em R. A ordem é a mercado e executa
//     na abertura da barra seguinte do gráfico (no gráfico de 1m = minuto
//     seguinte).
//     Modelo "At zone": entra a mercado quando os filtros confirmam (como
//     antes), stop % para lá da zona, TP %.
enteredNow = false
if useTrig
    nMin = array.size(m1H)
    if nMin > 0
        for k = 0 to nMin - 1
            mH = array.get(m1H, k)
            mL = array.get(m1L, k)
            mC = array.get(m1C, k)
            mO = array.size(m1O) > k ? array.get(m1O, k) : mC
            if useRsi
                rsiFeed(array.get(m1T, k), mC)
            mT = array.get(m1T, k)
            // Toques nas zonas armadas -> novos sinais.
            if not enteredNow and array.size(pendBase) > 0
                for i = 0 to array.size(pendBase) - 1
                    b  = array.get(pendBase, i)
                    lg = array.get(pendLong, i)
                    ep = array.get(pendPx, i)
                    touched = lg ? mL <= ep : mH >= ep
                    if touched and not array.includes(trgBase, b) and not map.contains(traded, b)
                        array.push(trgBase, b)
                        array.push(trgLong, lg)
                        array.push(trgEntry, ep)
                        array.push(trgSL, array.get(pendSL, i))
                        array.push(trgLo, array.get(pendLo, i))
                        array.push(trgHi, array.get(pendHi, i))
                        array.push(trgMem, array.get(pendMem, i))
                        array.push(trgCnt, array.get(pendCnt, i))
                        array.push(trgExp, mT + (newEntry ? closeWait : rsiWindow) * 60000)
                        array.push(trgExt, lg ? mL : mH)
                        array.push(trgConf, false)
                        array.push(trgConfExp, mT + rsiWindow * 60000)
                        array.push(trgLbl, "")
                        array.push(trgPrevRT, false)
            // Atualiza o low/high do bounce; expira sinais antigos ou cuja
            // zona foi rompida até ao stop % da zona.
            if array.size(trgBase) > 0
                for i = array.size(trgBase) - 1 to 0
                    lg = array.get(trgLong, i)
                    array.set(trgExt, i, lg ? math.min(array.get(trgExt, i), mL) : math.max(array.get(trgExt, i), mH))
                    sl = array.get(trgSL, i)
                    broken = not na(sl) and (lg ? mL <= sl : mH >= sl)
                    if mT > array.get(trgExp, i) or broken
                        trgRemove(i)
            // Filtros: no modelo novo basta confirmarem uma vez desde o toque
            // (até ao limite 'Minutes after touch...' ou até à vela de entrada).
            if array.size(trgBase) > 0
                for i = 0 to array.size(trgBase) - 1
                    if not array.get(trgConf, i)
                        lg = array.get(trgLong, i)
                        [rsiOk0, rsiLbl] = rsiCheck(lg)
                        [liqOk0, liqLbl] = liqCheck(lg, mT)
                        [absOk0, absLbl] = absCheck(lg, mT, array.get(trgLo, i), array.get(trgHi, i))
                        if (not useRsi or rsiOk0) and (not useLiq or liqOk0) and (not useAbs or absOk0)
                            array.set(trgConf, i, true)
                            array.set(trgLbl, i, (useRsi ? " RSI" + rsiLbl : "") + (useLiq ? " LIQ" + liqLbl : "") + (useAbs ? absLbl : ""))
            // Entrada.
            if not enteredNow and strategy.position_size == 0 and inWindow and array.size(trgBase) > 0
                for i = array.size(trgBase) - 1 to 0
                    if not enteredNow and array.get(trgConf, i)
                        lg = array.get(trgLong, i)
                        float sl = na
                        float tp = na
                        bool go = false
                        if newEntry
                            // Padrão de bounce: vela ANTERIOR vermelha (long) a tocar
                            // a zona + esta vela fecha verde (e acima da zona, se
                            // 'bounceBeyond'). Short: espelho.
                            bool bounceCandle = lg ? mC > mO : mC < mO
                            bool beyondOk = not bounceBeyond or (lg ? mC > array.get(trgHi, i) : mC < array.get(trgLo, i))
                            go := array.get(trgPrevRT, i) and bounceCandle and beyondOk
                            ext = array.get(trgExt, i)
                            sl := lg ? ext * (1 - slBufferPct / 100) : ext * (1 + slBufferPct / 100)
                            go := go and (lg ? sl < mC : sl > mC)
                            tp := lg ? mC + rrMult * (mC - sl) : mC - rrMult * (sl - mC)
                        else
                            sl := array.get(trgSL, i)
                            go := na(sl) or (lg ? sl < mC : sl > mC)
                            tp := tpPct > 0 ? (lg ? mC * (1 + tpPct / 100) : mC * (1 - tpPct / 100)) : na
                        if go
                            b = array.get(trgBase, i)
                            cnt = array.get(trgCnt, i)
                            eid = b + "#" + str.tostring(map.contains(fillCnt, b) ? map.get(fillCnt, b) : 0)
                            mult = sizeByCount ? math.min(cnt, maxSizeMult) : 1
                            strategy.entry(eid, lg ? strategy.long : strategy.short, qty = strategy.equity * basePct / 100 * mult / mC,
                                 comment = (lg ? "L " : "S ") + eid + array.get(trgLbl, i))
                            strategy.exit("X|" + eid, from_entry = eid, stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")
                            map.put(tpById, eid, tp)
                            map.put(slById, eid, sl)
                            map.put(filled, eid, true)
                            map.put(fillCnt, b, (map.contains(fillCnt, b) ? map.get(fillCnt, b) : 0) + 1)
                            lockKey(b, array.get(trgEntry, i))
                            for m in str.split(array.get(trgMem, i), ";")
                                lockKey(m, str.tonumber(str.substring(m, 2)))
                            needSel := true
                            enteredNow := true
            // Guarda, para o minuto seguinte, se ESTA vela foi vermelha (long) /
            // verde (short) e tocou a zona.
            if not enteredNow and array.size(trgBase) > 0
                for i = 0 to array.size(trgBase) - 1
                    lg = array.get(trgLong, i)
                    touchesNow = lg ? mL <= array.get(trgHi, i) : mH >= array.get(trgLo, i)
                    array.set(trgPrevRT, i, touchesNow and (lg ? mC < mO : mC > mO))
    if enteredNow
        trgClear()

// 2) POCs candidatos: em cada timeframe junta TODOS os POCs (New + Naked +
//    Tapped, sem distinção), tira os preços já usados e fica com os N mais
//    próximos do preço. Recalculado só ao fecho do dia ou quando algum nível
//    é usado (para não pesar em cada barra).
priceKey(float p) =>
    "P|" + str.tostring(p, format.mintick)

buildTradeSel(TFState st, float ref) =>
    pool = array.new<float>()
    // Só entram os tipos ligados nas settings (o que não aparece não é negociado).
    if st.showNew and st.hasNew and not map.contains(traded, priceKey(st.newPrice))
        array.push(pool, st.newPrice)
    if st.showNaked
        for p in st.nakedPrices
            if not map.contains(traded, priceKey(p))
                array.push(pool, p)
    if st.showTapped and st.hasTapped
        for p in st.tappedPrices
            if not map.contains(traded, priceKey(p))
                array.push(pool, p)
    st.tradeSel := selectClosest(pool, nTradeLevels, ref)

if hadNewDay or nakedLive or tappedLive
    needSel := true
if needSel
    buildTradeSel(st1D, close)
    buildTradeSel(st2D, close)
    buildTradeSel(st3D, close)
    buildTradeSel(st5D, close)
    buildTradeSel(st1W, close)
    buildTradeSel(st2W, close)
    buildTradeSel(st1M, close)
    needSel := false

candKey = array.new<string>()
candPx  = array.new<float>()

if inWindow
    for st in allTF
        for p in st.tradeSel
            key = priceKey(p)
            if not map.contains(traded, key) and not array.includes(candKey, key)
                array.push(candKey, key)
                array.push(candPx, p)

// 3) Agrupa em zonas (ordenado por preço, single-linkage com largura máxima).
zLo  = array.new<float>()
zHi  = array.new<float>()
zCnt = array.new<int>()
zMem = array.new<string>()
nCand = array.size(candPx)
if nCand > 0
    ordIdx = array.sort_indices(candPx, order.ascending)
    float curLo = na
    float curHi = na
    int curCnt = 0
    string curMem = ""
    for k = 0 to nCand - 1
        j = array.get(ordIdx, k)
        p = array.get(candPx, j)
        key = array.get(candKey, j)
        if na(curLo)
            curLo := p
            curHi := p
            curCnt := 1
            curMem := key
        else if p - curHi <= curHi * clusterPct / 100 and p - curLo <= curLo * maxZonePct / 100
            curHi := p
            curCnt += 1
            curMem := curMem + ";" + key
        else
            array.push(zLo, curLo)
            array.push(zHi, curHi)
            array.push(zCnt, curCnt)
            array.push(zMem, curMem)
            curLo := p
            curHi := p
            curCnt := 1
            curMem := key
    array.push(zLo, curLo)
    array.push(zHi, curHi)
    array.push(zCnt, curCnt)
    array.push(zMem, curMem)

// 4) Uma ordem por zona elegível - só quando NÃO há posição aberta.
flat = strategy.position_size == 0 and not enteredNow
newIds = array.new<string>()
newBase = array.new<string>()
newPx  = array.new<float>()
newMem = array.new<string>()
newLong = array.new<bool>()
newSL  = array.new<float>()
newLo  = array.new<float>()
newHi  = array.new<float>()
newTP  = array.new<float>()
newQty = array.new<float>()
newCnt = array.new<int>()
nZones = array.size(zLo)
if nZones > 0 and flat
    for z = 0 to nZones - 1
        lo  = array.get(zLo, z)
        hi  = array.get(zHi, z)
        cnt = array.get(zCnt, z)
        inside = close >= lo and close <= hi
        if cnt >= minPocsZone and not inside
            isLong = hi < close
            entryPx = entryMode == "Zone middle" ? (lo + hi) / 2 : (isLong ? hi : lo)
            zid = "Z|" + str.tostring(lo, format.mintick) + "-" + str.tostring(hi, format.mintick) + "|" + str.tostring(cnt)
            if ((isLong and allowLong) or (not isLong and allowShort)) and not map.contains(traded, zid) and not array.includes(newBase, zid)
                farEdge = isLong ? lo : hi
                float sl = slPct > 0 ? (isLong ? farEdge * (1 - slPct / 100) : farEdge * (1 + slPct / 100)) : na
                float tp = tpPct > 0 ? (isLong ? entryPx * (1 + tpPct / 100) : entryPx * (1 - tpPct / 100)) : na
                mult = sizeByCount ? math.min(cnt, maxSizeMult) : 1
                qty = strategy.equity * basePct / 100 * mult / entryPx
                array.push(newIds, zid + "#" + str.tostring(map.contains(fillCnt, zid) ? map.get(fillCnt, zid) : 0))
                array.push(newBase, zid)
                array.push(newPx, entryPx)
                array.push(newMem, array.get(zMem, z))
                array.push(newLong, isLong)
                array.push(newSL, sl)
                array.push(newLo, lo)
                array.push(newHi, hi)
                array.push(newTP, tp)
                array.push(newQty, qty)
                array.push(newCnt, cnt)

// 5) Cancela ordens de zonas que deixaram de existir (o SL/TP de entradas já
//    executadas mantém-se).
if not useTrig and array.size(pendIds) > 0
    for i = 0 to array.size(pendIds) - 1
        oid = array.get(pendIds, i)
        if not array.includes(newIds, oid) and not map.contains(filled, oid)
            strategy.cancel(oid)
            if not map.contains(filled, oid)
                strategy.cancel("X|" + oid)

// 6) Coloca/atualiza as ordens. O nome do grupo OCA muda a cada trade, para
//    o grupo de uma trade antiga não cancelar as ordens da seguinte.
ocaName = "POC" + str.tostring(strategy.closedtrades + strategy.opentrades)
// Momento atual para os filtros (último minuto avaliado nesta vela).
lastStepT = array.size(m1T) > 0 ? array.last(m1T) : time
prevPend = array.copy(pendIds)
placedNow = array.new<string>()
array.clear(pendIds)
array.clear(pendBase)
array.clear(pendPx)
array.clear(pendMem)
array.clear(pendLong)
array.clear(pendSL)
array.clear(pendLo)
array.clear(pendHi)
array.clear(pendCnt)
if array.size(newIds) > 0
    for i = 0 to array.size(newIds) - 1
        oid = array.get(newIds, i)
        p   = array.get(newPx, i)
        isLong = array.get(newLong, i)
        sl = array.get(newSL, i)
        tp = array.get(newTP, i)
        // Sem filtros: ordem limit em todas as zonas.
        // Com filtros (RSI/liquidações): a zona fica "armada" e a entrada é
        // feita no passo 1c (toque + confirmação -> mercado) OU, se os filtros
        // JÁ estiverem confirmados agora, com uma ordem limit no POC.
        bool placeLimit = not useTrig
        string cmt = ""
        if useConfirm and preLimit and flat and not newEntry
            [rOk0, rLbl0] = rsiCheck(isLong)
            [lOk0, lLbl0] = liqCheck(isLong, lastStepT)
            [aOk0, aLbl0] = absCheck(isLong, lastStepT, array.get(newLo, i), array.get(newHi, i))
            if (not useRsi or rOk0) and (not useLiq or lOk0) and (not useAbs or aOk0)
                placeLimit := true
                cmt := " LIM" + (useRsi ? " RSI" + rLbl0 : "") + (useLiq ? " LIQ" + lLbl0 : "") + (useAbs ? aLbl0 : "")
        if placeLimit
            strategy.entry(oid, isLong ? strategy.long : strategy.short, qty = array.get(newQty, i), limit = p,
                 oca_name = ocaName, oca_type = strategy.oca.cancel,
                 comment = (isLong ? "L " : "S ") + oid + cmt)
            if not na(sl) or not na(tp)
                strategy.exit("X|" + oid, from_entry = oid, stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")
            map.put(tpById, oid, tp)
            array.push(placedNow, oid)
        array.push(pendLong, isLong)
        array.push(pendSL, sl)
        array.push(pendLo, array.get(newLo, i))
        array.push(pendHi, array.get(newHi, i))
        array.push(pendCnt, array.get(newCnt, i))
        array.push(pendIds, oid)
        array.push(pendBase, array.get(newBase, i))
        array.push(pendPx, p)
        array.push(pendMem, array.get(newMem, i))

// Com filtros: cancela ordens limit da vela anterior que não foram
// recolocadas agora (filtros deixaram de confirmar, zona mudou, ...).
if useTrig and array.size(prevPend) > 0
    for oid in prevPend
        if not array.includes(placedNow, oid) and not map.contains(filled, oid)
            strategy.cancel(oid)
            strategy.cancel("X|" + oid)

// Modelo "Close beyond zone": recalcula o TP (R múltiplos) com o preço REAL
// de entrada (a ordem a mercado executa na abertura da vela seguinte).
var string rrFixedId = ""
if newEntry and strategy.opentrades > 0
    tid0 = strategy.opentrades.entry_id(0)
    if tid0 != rrFixedId and map.contains(slById, tid0)
        rrFixedId := tid0
        ePx0 = strategy.opentrades.entry_price(0)
        sl0 = map.get(slById, tid0)
        isL0 = strategy.position_size > 0
        risk0 = math.abs(ePx0 - sl0)
        tp0 = isL0 ? ePx0 + rrMult * risk0 : ePx0 - rrMult * risk0
        strategy.exit("X|" + tid0, from_entry = tid0, stop = sl0, limit = tp0, comment_loss = "SL", comment_profit = "TP")
        map.put(tpById, tid0, tp0)

// Break-even: N velas de 1m SEGUIDAS a fechar em lucro -> stop no preço de
// entrada (+ offset). Conta só velas de 1m que abriram depois da entrada.
var string beTradeId = ""
var int beCount = 0
var bool beDone = false
var int beLastT = 0
if useBE and strategy.opentrades > 0
    tid = strategy.opentrades.entry_id(0)
    if tid != beTradeId
        beTradeId := tid
        beCount := 0
        beDone := false
        beLastT := 0
    if not beDone
        ePx = strategy.opentrades.entry_price(0)
        eT  = strategy.opentrades.entry_time(0)
        isL = strategy.position_size > 0
        nM = array.size(m1C)
        if nM > 0
            for k = 0 to nM - 1
                mt = array.get(m1T, k)
                if mt >= eT and mt > beLastT and not beDone
                    mc = array.get(m1C, k)
                    inProfit = isL ? mc > ePx : mc < ePx
                    beCount := inProfit ? beCount + 1 : 0
                    beLastT := mt
                    if beCount >= beBars
                        beDone := true
        if beDone
            bePx = isL ? ePx * (1 + beOffsetPct / 100) : ePx * (1 - beOffsetPct / 100)
            float keepTP = map.contains(tpById, tid) ? map.get(tpById, tid) : na
            strategy.exit("X|" + tid, from_entry = tid, stop = bePx, limit = keepTP, comment_loss = "BE", comment_profit = "TP")
else if strategy.opentrades == 0
    beTradeId := ""

// Fecha tudo fora da janela de trading.
if not inWindow and strategy.position_size != 0
    strategy.close_all(comment = "Fora da janela")

// Tabela de diagnóstico (última vela).
if barstate.islast and showDiag
    var table dg = table.new(position.bottom_left, 2, 8, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)
    lastT = array.size(m1T) > 0 ? array.last(m1T) : time
    rsiTxt = ""
    for i = 0 to 3
        if array.get(rsOn, i)
            rsiTxt := rsiTxt + str.tostring(array.get(rsMins, i)) + "m:" + str.tostring(array.get(curRsi, i), "#.0") + " "
    table.cell(dg, 0, 0, "Posição", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 0, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "flat", text_color = color.white, text_size = size.small)
    table.cell(dg, 0, 1, "Zonas armadas", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 1, str.tostring(array.size(pendBase)), text_color = color.white, text_size = size.small)
    table.cell(dg, 0, 2, "Sinais à espera (zona tocada)", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 2, str.tostring(array.size(trgBase)), text_color = color.white, text_size = size.small)
    table.cell(dg, 0, 3, "RSI", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 3, useRsi ? rsiTxt : "off", text_color = color.white, text_size = size.small)
    table.cell(dg, 0, 4, "Liq. longs (maior vela)", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 4, useLiq ? str.tostring(liqBestAll(true, lastT) / 1000000, "#.##") + "M  " + lqLongTicker : "off", text_color = color.white, text_size = size.small)
    table.cell(dg, 0, 5, "Liq. shorts (maior vela)", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 5, useLiq ? str.tostring(liqBestAll(false, lastT) / 1000000, "#.##") + "M  " + lqShortTicker : "off", text_color = color.white, text_size = size.small)
    table.cell(dg, 0, 6, "Unidades liq.", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 6, useLiq ? (lqInBase ? "BTC -> USD" : "USD") + " (" + lqVolType + ")" : "off", text_color = color.white, text_size = size.small)
    int nBuyBP = 0
    int nSellBP = 0
    if array.size(bpT) > 0
        for i = 0 to array.size(bpT) - 1
            if array.get(bpT, i) >= lastT + 60000 - absWindow * 60000
                if array.get(bpSell, i)
                    nSellBP += 1
                else
                    nBuyBP += 1
    table.cell(dg, 0, 7, "Big trades (janela) compra/venda", text_color = color.white, text_size = size.small)
    table.cell(dg, 1, 7, useAbs ? str.tostring(nBuyBP) + " / " + str.tostring(nSellBP) + "  (" + absEffTF + ", tol " + (absTolMode == "ATR" ? str.tostring(absAtr * absAtrMult, "#.#") : str.tostring(absTolPct) + "%") + ")" : "off", text_color = color.white, text_size = size.small)

// Aviso se o filtro de liquidações está ligado mas não chegam dados.
if barstate.islast and useLiq and not lqGotData
    var table lqWarn = table.new(position.bottom_right, 1, 1, bgcolor = color.new(color.red, 20))
    table.cell(lqWarn, 0, 0, "Sem dados de liquidações para " + lqLongTicker + " / " + lqShortTicker + " (ver 'Liquidations filter')", text_color = color.white, text_size = size.small)

// Desenho das zonas (só na última barra).
var array<box> zoneBoxes = array.new<box>()
if barstate.islast
    for b in zoneBoxes
        box.delete(b)
    array.clear(zoneBoxes)
    if showZones and nZones > 0
        for z = 0 to nZones - 1
            cnt = array.get(zCnt, z)
            if cnt >= minPocsZone
                lo = array.get(zLo, z)
                hi = array.get(zHi, z)
                col = hi < close ? color.new(color.teal, 80) : lo > close ? color.new(color.red, 80) : color.new(color.orange, 80)
                array.push(zoneBoxes, box.new(bar_index - 30, hi, bar_index + 10, lo, border_color = color.new(col, 40),
                     bgcolor = col, extend = extend.right, text = str.tostring(cnt) + " POC" + (cnt > 1 ? "s" : ""),
                     text_color = color.gray, text_size = size.small, text_halign = text.align_right))

// ---------------------------------------------------------------------------
// Desenho (igual ao indicador)
// ---------------------------------------------------------------------------
showLevels = lineThickness > 0

drawLevel(color col, float price) =>
    line.new(time[1], price, time, price, xloc = xloc.bar_time, extend = extend.both, color = col, style = line.style_dotted, width = lineThickness)

var array<line> drawnLines = array.new<line>()

drawTF(TFState st, array<float> nakedSel, float tappedSel) =>
    if showLevels
        if st.showNew and st.hasNew
            array.push(drawnLines, drawLevel(newColor, st.newPrice))
        if st.showNaked
            i = 0
            while i < array.size(nakedSel)
                p = array.get(nakedSel, i)
                if not na(p)
                    array.push(drawnLines, drawLevel(nakedColor, p))
                i += 1
        if st.showTapped and st.hasTapped and not na(tappedSel)
            array.push(drawnLines, drawLevel(tappedColor, tappedSel))

if barstate.islast
    for ln in drawnLines
        line.delete(ln)
    array.clear(drawnLines)
    drawTF(st1D, sel1D, selTp1D)
    drawTF(st2D, sel2D, selTp2D)
    drawTF(st3D, sel3D, selTp3D)
    drawTF(st5D, sel5D, selTp5D)
    drawTF(st1W, sel1W, selTp1W)
    drawTF(st2W, sel2W, selTp2W)
    drawTF(st1M, sel1M, selTp1M)

rawNew1D = st1D.showNew and st1D.hasNew ? st1D.newPrice : float(na)
rawNew2D = st2D.showNew and st2D.hasNew ? st2D.newPrice : float(na)
rawNew3D = st3D.showNew and st3D.hasNew ? st3D.newPrice : float(na)
rawNew5D = st5D.showNew and st5D.hasNew ? st5D.newPrice : float(na)
rawNew1W = st1W.showNew and st1W.hasNew ? st1W.newPrice : float(na)
rawNew2W = st2W.showNew and st2W.hasNew ? st2W.newPrice : float(na)
rawNew1M = st1M.showNew and st1M.hasNew ? st1M.newPrice : float(na)

plot(rawNew1D, title = "1D", color = na(rawNew1D) ? na : newColor, display = display.price_scale)
plot(rawNew2D, title = "2D", color = na(rawNew2D) ? na : newColor, display = display.price_scale)
plot(rawNew3D, title = "3D", color = na(rawNew3D) ? na : newColor, display = display.price_scale)
plot(rawNew5D, title = "5D", color = na(rawNew5D) ? na : newColor, display = display.price_scale)
plot(rawNew1W, title = "1W", color = na(rawNew1W) ? na : newColor, display = display.price_scale)
plot(rawNew2W, title = "2W", color = na(rawNew2W) ? na : newColor, display = display.price_scale)
plot(rawNew1M, title = "1M", color = na(rawNew1M) ? na : newColor, display = display.price_scale)

plot(array.get(sel1D, 0), title = "1D", color = nakedColor, display = display.price_scale)
plot(array.get(sel1D, 1), title = "1D", color = nakedColor, display = display.price_scale)
plot(array.get(sel1D, 2), title = "1D", color = nakedColor, display = display.price_scale)
plot(array.get(sel2D, 0), title = "2D", color = nakedColor, display = display.price_scale)
plot(array.get(sel2D, 1), title = "2D", color = nakedColor, display = display.price_scale)
plot(array.get(sel2D, 2), title = "2D", color = nakedColor, display = display.price_scale)
plot(array.get(sel3D, 0), title = "3D", color = nakedColor, display = display.price_scale)
plot(array.get(sel3D, 1), title = "3D", color = nakedColor, display = display.price_scale)
plot(array.get(sel3D, 2), title = "3D", color = nakedColor, display = display.price_scale)
plot(array.get(sel5D, 0), title = "5D", color = nakedColor, display = display.price_scale)
plot(array.get(sel5D, 1), title = "5D", color = nakedColor, display = display.price_scale)
plot(array.get(sel5D, 2), title = "5D", color = nakedColor, display = display.price_scale)
plot(array.get(sel1W, 0), title = "1W", color = nakedColor, display = display.price_scale)
plot(array.get(sel1W, 1), title = "1W", color = nakedColor, display = display.price_scale)
plot(array.get(sel2W, 0), title = "2W", color = nakedColor, display = display.price_scale)
plot(array.get(sel2W, 1), title = "2W", color = nakedColor, display = display.price_scale)
plot(array.get(sel1M, 0), title = "1M", color = nakedColor, display = display.price_scale)
plot(array.get(sel1M, 1), title = "1M", color = nakedColor, display = display.price_scale)

plot(selTp1D, title = "1DT", color = tappedColor, display = display.price_scale)
plot(selTp2D, title = "2DT", color = tappedColor, display = display.price_scale)
